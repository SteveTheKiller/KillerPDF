<!-- Killer Sans UI with CJK text drawn at 90% in Microsoft JhengHei UI, so it reads the same size as the
     Latin text around it (#490). UiFontStack names this family for Traditional Chinese and every
     language without a CJK face of its own. -->
<FontFamily xmlns="http://schemas.microsoft.com/winfx/2006/xaml/composite-font"
            xmlns:System="clr-namespace:System;assembly=mscorlib"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            LineSpacing="1.3300604229607251" Baseline="1.0793051359516617">
  <FontFamily.FamilyNames>
    <System:String x:Key="en-US">Killer Sans UI CJK</System:String>
  </FontFamily.FamilyNames>
  <FontFamily.FamilyMaps>
    <FontFamilyMap Unicode="1100-11FF, 2E80-9FFF, A960-A97F, AC00-D7FF, F900-FAFF, FE30-FE4F, FF00-FFEF, 20000-3FFFF"
                   Target="Microsoft JhengHei UI, Malgun Gothic" Scale="0.9"/>
    <FontFamilyMap Unicode="0000-10FFFF" Target="./#Killer Sans UI, Segoe UI, Nirmala UI"/>
  </FontFamily.FamilyMaps>
</FontFamily>
