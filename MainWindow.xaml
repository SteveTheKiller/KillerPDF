                <Border Background="{DynamicResource BgModal}"
                        BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="28,16,28,22"
                        MouseLeftButtonDown="ShortcutOverlayCard_MouseLeftButtonDown"
                        MouseRightButtonDown="ShortcutOverlayCard_MouseLeftButtonDown">
