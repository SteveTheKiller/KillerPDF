                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Info card - matte panel lifted above the grainy card with a drop shadow.
                         Shadow is a separate element so the card's text stays crisp. -->
                    <Grid>
                    <Border Background="{DynamicResource BgPanel}" CornerRadius="4" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="{DynamicResource BgPanel}"
                            CornerRadius="4"
                            Padding="14,12,14,4">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="AboutVersionBlock"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="12"
                                           Foreground="{DynamicResource Accent}"
                                           Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="AboutPublisherBlock"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="AboutThumbprintBlock"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_About_ExeSha}" Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="AboutSha256Block"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <!-- Update notice: shown only when a newer release is found (set in code-behind) -->
                    <Button x:Name="AboutUpdateButton" Visibility="Collapsed"
                            Margin="0,14,0,0" HorizontalAlignment="Left"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Click="AboutUpdateButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UpdBd" Background="Transparent"
                                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                        CornerRadius="4" Padding="14,7">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UpdBd" Property="Background" Value="{DynamicResource AccentDim}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="AboutUpdateText" Text="Update available"
                                   FontFamily="Segoe UI, Microsoft JhengHei UI, Nirmala UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"/>
                    </Button>
                    <!-- Tiny destructive footer link, bottom-right like the main-window footer, red on hover. -->
                    <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,10,0,0"
                               HorizontalAlignment="Right">
                        <Hyperlink TextDecorations="None" Cursor="Hand" Click="AboutClearData_Click">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFooter}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="Clear all Data"/>
                        </Hyperlink>
                    </TextBlock>
                    </StackPanel>
                    <!-- X close button overlaid at top-right - no vertical space consumed -->
                    <Button Click="AboutOverlayClose_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="24" Height="24" Content="&#xE711;"
                            Style="{StaticResource DangerCloseButton}"/>
                </Grid>
                </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    </Border>
    </Grid>
</Window>
