                <!-- Shadow cast by a separate element so the card content stays crisp. -->
                <Border Background="{DynamicResource BgModal}" CornerRadius="6" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                    </Border.Effect>
