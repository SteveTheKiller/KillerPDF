<!-- Themed replacement for Microsoft.Win32.OpenFileDialog / SaveFileDialog.
     Same chrome, places rail, view modes and sortable columns as FolderPickerDialog - the row
     styles and templates are shared from Controls.xaml - plus a file name box, a filter combo
     and Open/Save behavior. The property surface deliberately mirrors the Win32 dialogs
     (Title, Filter, FilterIndex, FileName, InitialDirectory, DefaultExt, ...) so a call site
     changes by one word. -->
<Window x:Class="KillerPDF.Controls.FileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:KillerFamily.Accessibility"
        xmlns:kui="clr-namespace:KillerPDF.Controls"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        Title="KillerPDF"
        Width="720" Height="520" MinWidth="560" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <!-- Every picker style lives in the family Controls.xaml. Only the recent-locations arrow and
         its list rows, which no other control uses, are kept here. -->
    <Window.Resources>
        <!-- The recent-locations arrow. On a Win98 caption theme (RootBorder.Tag is
             UseDialogCaption) it is the Win98 combo drop button: 16 wide, standing inside the path
             box's 2px sunken edge from top to bottom, with the four-layer raised bevel the implicit
             ComboBox's drop button uses. It was a fixed 26px-tall face laid over a 22px box with a
             single bevel ring, so it overhung the field and read as a loose gray tile. -->
        <Style x:Key="PickerComboArrowBtn" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource ComboButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource ComboButtonHeight}"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource ComboChevFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="face" Background="{DynamicResource ComboButtonBrush}"/>
                            <Border x:Name="bevelLight" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource BevelLightBrush}"
                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                            <Border x:Name="bevelDark" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                    BorderBrush="{DynamicResource BevelDarkBrush}"
                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                            <Border x:Name="bevelInnerLight" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                    BorderBrush="{DynamicResource BevelInnerLightBrush}"
                                    BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                            <Border x:Name="bevelOuterDark" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource BevelOuterDarkBrush}"
                                    BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover turns the chevron red like a card's close X, with no face behind it.
                                 On 98SE AboutCloseHoverFg is the caption color, so a Win98 button stays put. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AboutCloseHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelOuterDarkBrush}"/>
                                <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelInnerLightBrush}"/>
                                <Setter TargetName="bevelInnerLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                <Setter TargetName="bevelOuterDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Width" Value="{DynamicResource ComboButtonMinWidth}"/>
                    <Setter Property="FontSize" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,2,2,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A recent-locations row: the family ComboBoxItem as a ListBoxItem, so the recents list
             reads like every other dropdown list. -->
        <Style x:Key="RecentsRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The file type combo: the family's field combo, so its face is the file name box's field
             and its open list carries the grain and ink like every other dropdown. Its height
             follows the file name box beside it, so on 98SE both drop to the compact Win98 field
             height together. -->
        <Style x:Key="PickerFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Height" Value="{DynamicResource CompactInputMinHeight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The places and file lists. On 98SE the pane's sunken edge is 2px all round, so the list
             is inset exactly that far and its scrollbar meets the edge; the 4px top and bottom
             inset left white strips above and below the gray scrollbar. -->
        <Style x:Key="PickerPaneList" TargetType="ListBox">
            <Setter Property="Padding" Value="2,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Padding" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cancel and Open on 98SE: a Win98 push button, a #c0c0c0 face with the four-layer raised
             edge (white and #dfdfdf top and left, black and #808080 bottom and right) that sinks on
             press. SurfaceButton is a flat toolbar chip there and OutlineButton an accent outline,
             so the picker's footer read as two different, wrong controls. Every other theme keeps
             SurfaceButton and OutlineButton exactly. -->
        <ControlTemplate x:Key="PickerClassicButtonTemplate" TargetType="Button">
            <Grid>
                <Border Background="{DynamicResource ChipFaceBrush}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="outerLight" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                <Border x:Name="innerDark" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                        BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                <Border x:Name="innerLight" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                        BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                <Border x:Name="outerDark" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="outerLight" Property="BorderBrush" Value="{DynamicResource BevelOuterDarkBrush}"/>
                    <Setter TargetName="innerDark" Property="BorderBrush" Value="{DynamicResource BevelInnerLightBrush}"/>
                    <Setter TargetName="innerLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                    <Setter TargetName="outerDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="PickerCancelButton" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Template" Value="{StaticResource PickerClassicButtonTemplate}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Height" Value="23"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerAcceptButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Template" Value="{StaticResource PickerClassicButtonTemplate}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Height" Value="23"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The caption row, matching DialogFrame.BuildTitleBar (every other dialog): no
             TitleBarPadding on a modern theme (it is the MAIN window's 14px logo inset), the icon
             and title 6px in, and the close vertically centered at the right. On a Win98 caption
             theme the row sits 4px in, TitleBarPadding's left inset, with no top inset: the 2px top
             inset pushed a centered row 1px below the band's middle. -->
        <Style x:Key="PickerTitleRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- 2 puts the icon 3 in from the card, as DialogFrame does (6 until KillerPDF 1.9.7). -->
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                    <Setter Property="Margin" Value="4,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The pane's 1px frame in PaneBorderBrush, as the main window's panes have, then the
             four-layer sunken edge. The bevel thicknesses are zero on the flat themes, so only
             the frame draws there; on 98SE the bevel's outer ring covers the frame. -->
        <Style x:Key="PaneBevelOverlay" TargetType="{x:Type Control}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Grid>
                            <Border BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"/>
                            <Border BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                            <Border BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                            <Border Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                            <Border Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- NO shell:WindowChrome. On an AllowsTransparency window it fills its own non-client area,
         which paints as a flat band all the way round the card - the "halo". It was NOT the only
         difference from the other four dialogs: the code-behind also called
         DwmChrome.SetRoundedCorners/SetThemeBorder, and on a layered window the DWM corner
         preference composites DWM's own rounded frame around the WINDOW rect (halo included),
         tinted by the border color - the band survived the WindowChrome removal because of it.
         Both are gone now; no WindowChrome, no DWM calls, same as the other four.

         Resize is done by hand instead, on the halo itself: Resize_MouseDown works out which edge
         or corner the pointer is in and hands the drag to Windows with WM_NCLBUTTONDOWN, the same
         mechanism Shell/Chrome.cs uses for the main window's grip. That needs the halo to receive
         mouse input, which is why this Grid is #01000000 (alpha 1/255) rather than Transparent -
         a fully transparent area gets no mouse events at all.

         Two earlier attempts blamed the wrong thing. The shadow WAS also wrong - it sat on the
         content Border, and this is the only dialog with a ComboBox, whose dropdown is an
         AllowsTransparency Popup; a WPF Effect over a subtree containing one renders as a filled
         rectangle. That is fixed below and is a real bug, it just was not this one.
         (2026-07-30, four attempts) -->
    <!-- RootFade, not RootBorder, is what the open/close animation drives - and it starts at 0,
         the same way KillerShell's RootGrid does. The fade used to run on RootBorder alone, but
         the shadow layer below is a SIBLING carrying the identical BackgroundBrush and geometry,
         with no starting opacity: it slammed in solid on the first frame and only the card faded
         on top of it, so the dialog read as blinking into existence rather than fading. Fading the
         shared parent takes the shadow with it. (2026-07-31) -->
    <Grid x:Name="RootFade" Opacity="0" Background="#01000000"
          MouseMove="Resize_MouseMove" MouseLeftButtonDown="Resize_MouseDown">

        <!-- Shadow layer: same geometry, NO content, not hit-testable. -->
        <Border Margin="{DynamicResource DialogHaloMargin}" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BackgroundBrush}" BorderThickness="{DynamicResource DialogFrameThickness}"
                IsHitTestVisible="False">
            <Border.Effect>
                <!-- RenderingBias Quality: at radius 18 the default Performance bias renders the
                     blur at reduced resolution and scales it up, which blocks up into stair-steps
                     on this card's rounded corners. Same fix as App.xaml's PaneShadow. -->
                <!-- Opacity follows the theme. A flat palette sets FlyoutShadowOpacity to 0, which
                     removes the cast entirely rather than leaving a soft halo round a hard-edged
                     window. Every other theme keeps the 0.6 it had. -->
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="{DynamicResource FlyoutShadowOpacity}"
                                  RenderingBias="Quality"/>
            </Border.Effect>
        </Border>

        <!-- Corner radius follows the theme, not a hardcoded 6: a square-cornered palette was
             getting a rounded card, and its square bevel then cut across the corners. -->
        <kui:PickerBorder x:Name="RootBorder" Tag="{DynamicResource UseDialogCaption}" BorderBrush="{DynamicResource DialogFrameBrush}" BorderThickness="{DynamicResource DialogFrameThickness}"
                Background="{DynamicResource BackgroundBrush}"
                CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource DialogHaloMargin}"
                Padding="{DynamicResource DialogWindowFramePadding}">
            <Grid>
            <Grid.RowDefinitions>
                <!-- Auto, with the height on the band itself: DialogTitleBarHeight is a Double and
                     a RowDefinition wants a GridLength, which will not convert. -->
                <RowDefinition Height="Auto"/>  <!-- title bar -->
                <RowDefinition Height="Auto"/>  <!-- heading -->
                <RowDefinition Height="Auto"/>  <!-- path row -->
                <RowDefinition Height="*"/>     <!-- places | entries -->
                <RowDefinition Height="Auto"/>  <!-- file name + filter -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Shared film grain over the whole dialog surface -->
            <Border Grid.RowSpan="6" IsHitTestVisible="False"
                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>

            <!-- Title bar: transparent by default so it shows the card and its grain, one surface
                 with the body, or the theme's own caption band where one is asked for (98SE). -->
            <Border Grid.Row="0" Height="{DynamicResource DialogTitleBarHeight}"
                    Background="{DynamicResource DialogTitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                <Grid>
                    <StackPanel Style="{StaticResource PickerTitleRow}">
                    <kui:AppIcon x:Name="TitleIcon" Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                                 Margin="{DynamicResource TitleIconMargin}" VerticalAlignment="Center"
                                 RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- The family wordmark, then the caller's Title ("Save PDF as") in the main
                         window's file name face, as DialogFrame titles its dialogs. The wordmark
                         block is ConfirmDialog's, copied as is; the title rides in the same TextBlock
                         so it shares the wordmark's baseline. The title layer is split from the
                         bevelled wordmark layer so it keeps ClearType, as DialogFrame does. -->
                    <Grid VerticalAlignment="Center" Margin="0,-18,0,-22" IsHitTestVisible="False">
                        <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                    Visibility="{DynamicResource DialogWordmarkVisibility}"
                                    Opacity="{DynamicResource WordmarkShadowOpacity}">
                            <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run x:Name="WordLead0" Text="Killer" Foreground="#D8000000"/><Run x:Name="WordAccent0" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/><Run FontFamily="{DynamicResource FileNameFont}" FontSize="{DynamicResource FileNameFontSize}" Foreground="#D8000000" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=OneWay, StringFormat='{}  {0}'}"/></TextBlock>
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                   Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run x:Name="WordLead1" Text="Killer" Foreground="Transparent"/><Run x:Name="WordAccent1" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                        <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                   Visibility="{DynamicResource DialogWordmarkVisibility}"><Run x:Name="WordLead2" Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run x:Name="WordAccent2" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/><Run FontFamily="{DynamicResource FileNameFont}" FontSize="{DynamicResource FileNameFontSize}" Foreground="Transparent" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=OneWay, StringFormat='{}  {0}'}"/></TextBlock>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                   Visibility="{DynamicResource DialogWordmarkVisibility}"
                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                                   RenderOptions.ClearTypeHint="Enabled"><Run x:Name="WordLead3" Text="Killer" Foreground="Transparent"/><Run x:Name="WordAccent3" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="Transparent"/><Run FontFamily="{DynamicResource FileNameFont}" FontSize="{DynamicResource FileNameFontSize}" Foreground="{DynamicResource FilenameBrush}" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=OneWay, StringFormat='{}  {0}'}"/></TextBlock>
                    </Grid>
                    <!-- 98SE's plain caption keeps the bare operation name, outside the wordmark grid so
                         the wordmark's lift and bleed never move it. -->
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               FontFamily="{DynamicResource ChromeFontFamily}"
                               FontSize="{DynamicResource MenuFontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource ChromeTextBrush}"
                               Visibility="{DynamicResource DialogPlainTitleVisibility}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </StackPanel>
                    <!-- The family overlay and dialog close (App.xaml, OverlayCloseButton): the glyph
                         reddens on hover without a fill, and 98SE gets the caption button face.
                         Centered in the band, as DialogFrame centers every other dialog's close; it
                         was top-aligned and pushed 14px in by TitleBarPadding. -->
                    <Button x:Name="CaptionCloseButton" Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click"
                            ToolTip="{DynamicResource Str_Sys_Close}" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                            Style="{StaticResource OverlayCloseButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="{DynamicResource DialogCloseWidth}" Height="{DynamicResource DialogCloseHeight}"
                            Margin="{DynamicResource DialogCaptionButtonsMargin}"/>
                </Grid>
                </Grid>
            </Border>

            <!-- Path row: up one level + current path + view modes -->
            <!-- 16 at the sides like every other dialog body; only the two panes below keep the 4 px
                 window gutter. -4 above takes the 12 spare under the title bar. -->
            <Grid Grid.Row="2" Margin="16,-4,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="UpButton" Content="&#xE74A;" Click="Up_Click"
                            ToolTip="{DynamicResource Str_TT_Up}" Style="{StaticResource PickerViewBtn}"
                            Margin="0,0,6,0"/>
                    <!-- New folder (#498): a name box under the button; Enter creates the folder and opens it. -->
                    <Button x:Name="NewFolderButton" Content="&#xE8F4;" Click="NewFolder_Click"
                            ToolTip="{DynamicResource Str_TT_NewFolder}" AutomationProperties.Name="{DynamicResource Str_FD_NewFolder}"
                            Style="{StaticResource PickerViewBtn}" Margin="0,0,6,0"/>
                    <Popup x:Name="NewFolderPopup" PlacementTarget="{Binding ElementName=NewFolderButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="2"
                           Closed="NewFolderPopup_Closed">
                        <Border Background="{DynamicResource FileDialogPaneBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8">
                            <StackPanel Width="260">
                                <TextBox x:Name="NewFolderBox" Style="{StaticResource DialogPickerTextBox}"
                                         AutomationProperties.Name="{DynamicResource Str_FD_NewFolder}"
                                         FontFamily="{DynamicResource UiFont}" FontSize="12" Padding="8,0,8,0" Height="28"
                                         VerticalContentAlignment="Center" KeyDown="NewFolderBox_KeyDown"/>
                                <TextBlock x:Name="NewFolderError" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,6,2,0"
                                           AutomationProperties.LiveSetting="Assertive"
                                           FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource DimTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <!-- Explicit style: an unstyled TextBox falls back to WPF's white fill and blue
                     focus border. The chevron overlays the box's right edge (the box pads 28 to
                     clear it) and drops the recent-locations list, like Explorer's address bar. -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="PathBox" Style="{StaticResource DialogPickerTextBox}"
                             AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                             FontFamily="{DynamicResource UiFont}" FontSize="12" Padding="8,0,28,0"
                             VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
                    <Button x:Name="RecentsBtn" Content="{DynamicResource ComboChevGlyph}" Click="RecentsBtn_Click"
                            ToolTip="{DynamicResource Str_TT_RecentLocations}"
                            Style="{StaticResource PickerComboArrowBtn}"
                            HorizontalAlignment="Right"/>
                    <!-- Recent locations: the family dropdown list, built exactly like the implicit
                         ComboBox's popup in Controls.xaml (surface, edge, corners, shadow, ink and
                         grain), as wide as the path box and hanging straight off it. The 1px offset
                         shares the box's bottom edge, the margin leaves the shadow room on the three
                         free sides, and RecentsPopup_Opened squares the corners where the two meet. -->
                    <Popup x:Name="RecentsPopup" PlacementTarget="{Binding ElementName=PathBox}"
                           Placement="Bottom" VerticalOffset="-1" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Opened="RecentsPopup_Opened" Closed="RecentsPopup_Closed">
                        <Border x:Name="RecentsBd" Width="{Binding ActualWidth, ElementName=PathBox}" MaxHeight="280"
                                kui:ThemeMotif.Part="Popup" kui:ThemeMotif.BaseBrush="ComboPopupBrush"
                                Background="{DynamicResource ComboPopupBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource MenuCornerRadius}" Margin="22,0,22,26" UseLayoutRounding="True"
                                Effect="{DynamicResource ComboPopupShadow}">
                            <Grid>
                                <ListBox x:Name="RecentsList" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4"
                                         AutomationProperties.Name="{DynamicResource Str_TT_RecentLocations}"
                                         ItemContainerStyle="{StaticResource RecentsRow}"
                                         SelectionChanged="RecentsList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Grain last, over the rows, so a highlighted row keeps its texture. -->
                                <Border IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=RecentsBd}"
                                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="SortButton" Style="{StaticResource PickerViewBtn}" Content="&#xE8CB;"
                            Click="SortButton_Click" Margin="0,0,6,0">
                        <Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_Col_Name}"/>
                                <TextBlock Text=" / "/>
                                <TextBlock Text="{DynamicResource Str_Col_Size}"/>
                                <TextBlock Text=" / "/>
                                <TextBlock Text="{DynamicResource Str_Col_Modified}"/>
                            </StackPanel>
                        </Button.ToolTip>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SortMenu" Style="{StaticResource CardMenu}" MinWidth="244" MaxWidth="244">
                                <MenuItem x:Name="SortNameItem" Header="{DynamicResource Str_Col_Name}"
                                          IsCheckable="True" Click="SortName_Click">
                                    <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE8CB;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="SortSizeItem" Header="{DynamicResource Str_Col_Size}"
                                          IsCheckable="True" Click="SortSize_Click">
                                    <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE799;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="SortModifiedItem" Header="{DynamicResource Str_Col_Modified}"
                                          IsCheckable="True" Click="SortModified_Click">
                                    <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE787;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- E7B3 (off) / E890 (on) - KillerShell's build-proven pair (ViewOptions.cs). -->
                    <Button x:Name="ShowHiddenBtn"  Style="{StaticResource PickerViewBtn}" Content="&#xE7B3;" ToolTip="{DynamicResource Str_TT_ShowHidden}"  Click="ShowHidden_Click"  Margin="0,0,6,0"/>
                    <Button x:Name="ViewListBtn"    Style="{StaticResource PickerViewBtn}" Content="&#xE8FD;" ToolTip="{DynamicResource Str_TT_ViewList}"    Click="ViewList_Click"/>
                    <Button x:Name="ViewIconsBtn"   Style="{StaticResource PickerViewBtn}" Content="&#xE80A;" ToolTip="{DynamicResource Str_TT_ViewIcons}"   Click="ViewIcons_Click"   Margin="2,0"/>
                    <Button x:Name="ViewDetailsBtn" Style="{StaticResource PickerViewBtn}" Content="&#xE700;" ToolTip="{DynamicResource Str_TT_ViewDetails}" Click="ViewDetails_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main: quick places on the left, folder contents on the right. The panes sit 8 px
                 from the card's sides and from each other; the rows around them sit 16 in, as
                 dialog content does. The 4 px window gutter looked cramped here (Steve 2026-11-26). -->
            <Grid Grid.Row="3" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ImagePreviewGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="ImagePreviewColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- A lifted card matching the file list (2026-08-15, revising the 2026-07-30 flat
                     call - the pane carried a fill anyway, so square shadowless edges read as a
                     bug, not flatness). Shadow on a SEPARATE border so text keeps ClearType.

                     KillerShell's own arrangement, not Explorer's: the tree fills the panel and
                     the pinned places sit BELOW it, the same slot its favorites drawer occupies,
                     so the two apps read identically. Draggable divider between. -->
                <!-- Trash Polka: the panes carry the window piece, as the main window's panes do, so the ink shows
                     through instead of a flat slab over the dialog's own ink. -->
                <Border Grid.Column="0" IsHitTestVisible="False"
                        Background="{DynamicResource FileDialogPaneBrush}"
                        kui:ThemeMotif.Part="Window" kui:ThemeMotif.BaseBrush="FileDialogPaneBrush"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <!-- Film grain on the places card - the card's fill covers the dialog-wide tile. -->
                <Border Grid.Column="0" IsHitTestVisible="False"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition x:Name="PlacesRow" Height="*" MinHeight="56"/>
                    </Grid.RowDefinitions>
                    <Control Grid.RowSpan="3" Panel.ZIndex="20" Style="{StaticResource PaneBevelOverlay}"/>
                    <ListBox x:Name="PlacesList" Grid.Row="2" Background="Transparent" BorderThickness="0" Style="{StaticResource PickerPaneList}" AutomationProperties.Name="{DynamicResource Str_Dlg_Places}"
                             ItemContainerStyle="{StaticResource PickerPlaceRow}" SelectionChanged="Places_SelectionChanged"
                             ContextMenuOpening="Places_ContextMenuOpening"
                             PreviewMouseLeftButtonDown="Places_PreviewMouseLeftButtonDown" PreviewMouseMove="Places_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="Places_PreviewMouseLeftButtonUp" LostMouseCapture="Places_LostMouseCapture"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource CardMenu}" MinWidth="244" MaxWidth="244">
                                <MenuItem Header="{DynamicResource Str_Menu_UnpinPlace}" Click="UnpinPlace_Click">
                                    <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE77A;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource PickerRowContent}">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                                           Margin="0,0,8,0" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource UiFont}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- KillerShell's divider verbatim (MainWindow.xaml, terms/filters split):
                         invisible grab band, 1px CardBorderBrush line, accent on hover and
                         while dragging. -->
                    <GridSplitter Grid.Row="1" Height="0" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                  Cursor="SizeNS" ShowsPreview="False" Focusable="False">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border x:Name="line" Height="1" VerticalAlignment="Center"
                                            Background="{DynamicResource CardBorderBrush}" Margin="12,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <!-- Left margin 0, not 4: the 16px expander gutter already provides the
                         inset, and the extra margin pushed the root icons visibly right of the
                         places icons below - dead space that cost horizontal room.
                         (2026-07-30) -->
                    <TreeView x:Name="FolderTreeCtl" Grid.Row="0" Style="{StaticResource FolderTreeView}" Visibility="Collapsed"
                              Margin="0,3,2,4"
                              PreviewMouseWheel="FolderTree_PreviewMouseWheel"
                              TreeViewItem.Expanded="FolderTree_Expanded"
                              ContextMenuOpening="FolderTree_ContextMenuOpening"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu Style="{StaticResource CardMenu}" MinWidth="244" MaxWidth="244">
                                <MenuItem Header="{DynamicResource Str_Menu_PinPlace}" Click="TreePin_Click">
                                    <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE718;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <!-- Inherits the themed template and adds the two-way state bindings,
                                 so RevealInTree can drive the tree from code. -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type kui:FolderNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           VerticalAlignment="Center" Margin="0,0,6,0" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TreeName}"
                                               ToolTip="{Binding Path}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <!-- Edge fades, KillerShell's tree pattern verbatim (MainWindow.xaml): the
                         overlay IS the surface - BackgroundBrush plus the same grain, exactly as
                         KillerShell's, now that the pane is flat on the card - under an opacity
                         mask, so rows dissolve into an exact match instead of a flat band.
                         Hit-test-transparent; each edge only shows while there is something PAST
                         it, ramped in code (SyncTreeEdgeFades). Right inset clears the
                         scrollbar; the bottom margin is driven from code when a horizontal bar
                         appears (SyncTreeFade). -->

                    <Border x:Name="TreeFadeTop" Grid.Row="0" Height="18" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Top" Margin="0,3,14,0" IsHitTestVisible="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid>
                            <Border Background="{DynamicResource BackgroundBrush}"/>
                            <Border Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="TreeFadeBottom" Grid.Row="0" Height="22" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Bottom" Margin="0,0,14,4" IsHitTestVisible="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid>
                            <Border Background="{DynamicResource BackgroundBrush}"/>
                            <Border Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        </Grid>
                    </Border>
                    <!-- The places list's scroll cues: the family scroll shadow (ScrollTopCue and
                         ScrollBottomCue), shown only while there is more past that edge and ramped in
                         by SyncPlacesEdgeFades. They used to be a band of the flat pane color, which on
                         Trash Polka covered the ink and read as a dead chin under the list (Steve
                         2026-11-26). The shadow runs under the scrollbar to the pane's edges. -->
                    <Border x:Name="PlacesFadeTop" Grid.Row="2" Height="24" Opacity="0"
                            VerticalAlignment="Top" IsHitTestVisible="False">
                        <Border Style="{StaticResource ScrollTopCue}" Height="24"
                                CornerRadius="{DynamicResource ControlCornerRadius}"/>
                    </Border>
                    <Border x:Name="PlacesFadeBottom" Grid.Row="2" Height="28" Opacity="0"
                            VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Border Style="{StaticResource ScrollBottomCue}" Height="28"
                                CornerRadius="{DynamicResource ControlCornerRadius}"/>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                  <Border Background="{DynamicResource FileDialogPaneBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                      <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                  </Border>
                  <Border Background="{DynamicResource FileDialogPaneBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                          kui:ThemeMotif.Part="Window" kui:ThemeMotif.BaseBrush="FileDialogPaneBrush">
                  <Grid>
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" x:Name="DetailsHeader" Visibility="Collapsed" Margin="12,4,26,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PickerColBtn}" Click="SortName_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Name}"/>
                                    <TextBlock x:Name="NameArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource PickerColBtn}" HorizontalContentAlignment="Right" Click="SortSize_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Size}"/>
                                    <TextBlock x:Name="SizeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PickerColBtn}" Margin="10,0,0,0" Click="SortModified_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Modified}"/>
                                    <TextBlock x:Name="ModArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Style="{StaticResource PickerPaneList}"
                                     AutomationProperties.Name="{DynamicResource Str_Col_Name}"
                                     ItemContainerStyle="{StaticResource PickerRow}"
                                     ItemTemplate="{StaticResource RowTemplate}"
                                     ItemsPanel="{StaticResource PanelStack}"
                                     SelectionChanged="Files_SelectionChanged" MouseDoubleClick="Files_DoubleClick"
                                     ContextMenuOpening="Files_ContextMenuOpening"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     PreviewMouseWheel="FileList_PreviewMouseWheel">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource CardMenu}" MinWidth="244" MaxWidth="244">
                                        <MenuItem Header="{DynamicResource Str_Menu_PinPlace}" Click="FilePin_Click">
                                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE718;"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="EmptyHint" Text="{DynamicResource Str_Dlg_NoMatchingFiles}" Visibility="Collapsed"
                                       Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20"/>
                        </Grid>
                    </DockPanel>
                  </Grid>
                  </Border>
                  <Control Panel.ZIndex="20" Style="{StaticResource PaneBevelOverlay}"/>
                </Grid>

                <!-- Image-only pickers opt into this pane. Keeping it in the shared dialog makes
                     Insert Image, image signatures, image stamps, and image-to-PDF import behave
                     identically without changing ordinary Open/Save dialogs. -->
                <Grid x:Name="ImagePreviewHost" Grid.Column="4" Visibility="Collapsed">
                    <Border Background="{DynamicResource FileDialogPaneBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270"
                                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="{DynamicResource FileDialogPaneBrush}"
                            kui:ThemeMotif.Part="Window" kui:ThemeMotif.BaseBrush="FileDialogPaneBrush"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Border IsHitTestVisible="False"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource GrainTileBrush}"
                                    Opacity="{DynamicResource GrainOpacity}"/>
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Str_Dlg_Preview}"
                                           FontFamily="{DynamicResource UiFont}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <a11y:Glyph x:Name="ImagePreviewPlaceholder" Text="&#xEB9F;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="42"
                                               Foreground="{DynamicResource DimTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImagePreview" Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Control Panel.ZIndex="20" Style="{StaticResource PaneBevelOverlay}"/>
                </Grid>
            </Grid>

            <!-- File name and file type share one row: the name takes the width, the type only what
                 its longest entry needs. With no filter (folder mode) the name runs the full row.
                 Labels are DimTextBrush on the dark card: 3.15:1, the tier these brushes are
                 calibrated for. -->
            <Grid x:Name="FileFields" Grid.Row="4" Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Dlg_FileName}" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11"/>
                <!-- Left padding 2.5: a TextBox's content host carries its own ~2px inset (WPF's
                     TextBoxView), so this starts the name where the combo's text starts. -->
                <TextBox x:Name="FileNameBox" Grid.Column="1"
                         AutomationProperties.Name="{DynamicResource Str_Dlg_FileName}"
                         Style="{StaticResource DialogPickerTextBox}"
                         FontFamily="{DynamicResource UiFont}" FontSize="12" Padding="2.5,0,8,0"
                         VerticalContentAlignment="Center" KeyDown="FileNameBox_KeyDown"
                         TextChanged="FileNameBox_TextChanged"/>

                <TextBlock x:Name="FilterLabel" Grid.Column="2" Text="{DynamicResource Str_Dlg_FileType}" VerticalAlignment="Center"
                           Margin="16,0,10,0" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11"/>
                <ComboBox x:Name="FilterCombo" Grid.Column="3" Width="220"
                          AutomationProperties.Name="{DynamicResource Str_Dlg_FileType}"
                          Style="{StaticResource PickerFilterCombo}"
                          SelectionChanged="Filter_SelectionChanged"/>
            </Grid>

            <!-- Footer: selection details on the left, actions on the right, 16 from the sides and
                 bottom like the confirm dialogs' button row. -->
            <Grid Grid.Row="5" Margin="16,12,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="SelName" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelMeta" FontFamily="{DynamicResource UiFont}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource PickerCancelButton}" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="AcceptButton" Style="{StaticResource PickerAcceptButton}" MinWidth="90" Click="OK_Click"/>
                </StackPanel>
            </Grid>

            </Grid>
        </kui:PickerBorder>

        <!-- The same directional 98SE window frame used by DialogChrome. Modern themes set these
             thicknesses to zero, so their existing card treatment is unchanged. -->
        <Grid Margin="{DynamicResource DialogHaloMargin}" IsHitTestVisible="False">
            <Border Margin="{DynamicResource WindowFrameMargin}"
                    BorderBrush="{DynamicResource WindowFrameBrush}"
                    BorderThickness="{DynamicResource DialogWindowFrameThickness}"/>
            <Border Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}"
                    BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                    BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
            <Border BorderBrush="{DynamicResource FrameOuterLightBrush}"
                    BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                    BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
        </Grid>
    </Grid>
</Window>
