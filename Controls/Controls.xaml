<!--
    KillerUI family control styles, identical in every app. Theme-independent; merge AFTER a
    Themes/{Theme}.xaml palette and BEFORE the app's own AppStyles.xaml. All brushes use
    DynamicResource so theme/accent changes repaint. Promoted from KillerShell, the family
    reference for theme colors, grain and geometry; app-only styles live in AppStyles.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:kl="clr-namespace:KillerFamily.Layout"
                    xmlns:input="clr-namespace:KillerFamily.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kui="clr-namespace:KillerPDF.Controls"
                    xmlns:snap="clr-namespace:KillerFamily.Windowing"
                    xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ImageBrush x:Key="GrainTileBrush" TileMode="Tile"
                ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>

    <kui:ThumbViewportFloorConverter x:Key="ThumbFloor"/>
    <kui:LastChildConverter x:Key="IsLastChild"/>

    <!-- Family brand faces, bundled in Fonts/ with their licenses beside them: Punktype
         (commercial license) for "Killer", Lacquer (OFL) for the app name and primary headings, and
         Killer Sans (OFL) for secondary headings and the footer. -->
    <FontFamily x:Key="WordmarkFont">/KillerPDF;component/Fonts/#Punktype</FontFamily>
    <FontFamily x:Key="WordmarkAccentFont">/KillerPDF;component/Fonts/#Lacquer</FontFamily>
    <FontFamily x:Key="BrandSansFont">/KillerPDF;component/Fonts/#Killer Sans</FontFamily>

    <kl:TooltipTextConverter x:Key="TooltipTextConverter"/>
    <Style TargetType="ToolTip">
        <Setter Property="kl:TooltipTextConverter.WrapContent" Value="True"/>
        <Setter Property="kl:CursorTooltipPlacement.Enabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock MaxWidth="300" TextWrapping="Wrap">
                                        <TextBlock.Text><MultiBinding Converter="{StaticResource TooltipTextConverter}">
                                            <Binding/><Binding Source="{x:Static kl:ShortcutHints.Current}" Path="Enabled"/>
                                        </MultiBinding></TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Hover/press are a translucent white/black tint OVER the accent, so every
                         theme + accent gets identical feedback from this one template. The old
                         PrimaryHoverBrush swap was invisible whenever a palette left hover ==
                         primary (which most did) - no per-palette hover brushes to sync now. -->
                    <Grid>
                        <!-- Raised: a soft shadow on item-free SIBLINGS under the face (an effect on the face
                             itself would rasterize the caption and lose ClearType). Hover lifts the button
                             higher, press sets it down. BarShadowOpacity is 0 on 98SE, which stays flat. -->
                        <Border x:Name="liftRest" IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Black" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="5" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                        <Border x:Name="liftHover" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Black" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="3.5" BlurRadius="10" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource ButtonEdgeBrush}" BorderThickness="0">
                        <Grid>
                            <Border x:Name="tint" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent"/>
                            <!-- The family stroke sits on a copy UNDER the label. An effect on the label
                                 itself rasterizes it, which blurs it at rest and snaps it back to
                                 hinted text on hover. With no stroke (98SE) the copy hides behind
                                 the label. Ideal grayscale text keeps a large display font smooth, with no
                                 ClearType fringes on the accent when hover drops the stroke. -->
                            <ContentPresenter x:Name="stroke" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
                                              Effect="{DynamicResource TextStroke}"/>
                            <ContentPresenter x:Name="label" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"/>
                        </Grid>
                    </Border>
                    <!-- Raised bevel. Nothing on any theme but 98SE, where a default button is a
                         real raised control rather than a flat accent slab. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                            BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="#2EFFFFFF"/>
                            <Setter TargetName="stroke" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="#38000000"/>
                            <Setter TargetName="stroke" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <!-- TRANSPARENT at rest. This is the family's outline button: an accent OUTLINE at rest
             that fills solid on hover. It was filled with RowSelectedBrush, which on the newer
             themes is a 27% white wash - so the Install button in the portable badge came up as
             a milky lozenge in a color belonging to no tier, with the accent text fighting it.
             A filled rest state also leaves nowhere for hover to go. -->
        <Setter Property="Background" Value="{DynamicResource OutlineFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineRestBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Raised: a soft shadow on item-free SIBLINGS under the face (an effect on the face
                             itself would rasterize the caption and lose ClearType). Hover lifts the button
                             higher, press sets it down. BarShadowOpacity is 0 on 98SE, which stays flat. -->
                        <Border x:Name="liftRest" IsHitTestVisible="False" Visibility="{DynamicResource OutlineLiftRestVisibility}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Transparent" BorderBrush="Black" BorderThickness="1" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="5" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                        <Border x:Name="liftHover" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Black" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="3.5" BlurRadius="10" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                    <Border x:Name="borderRing" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=border}" BorderThickness="{Binding BorderThickness, ElementName=border}" BorderBrush="{Binding Background, ElementName=border}" Margin="{Binding Margin, ElementName=border}" Visibility="{Binding Visibility, ElementName=border}" Opacity="{Binding Opacity, ElementName=border}"/><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="label" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Effect="{DynamicResource TextStroke}"/>
                    </Border>
                    <!-- Raised button bevel. Nothing on any theme but 98SE. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                            BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- OnOutlineBtnBrush, NOT OnPrimaryBrush: the fill here is
                             OutlineBtnBrush, and the two tokens diverge. White on Sepulchre's
                             #4faaa8 measures 2.75:1 and on Black's #00ff66 just 1.36:1.
                             ThemeManager derives this one against the actual fill, after the
                             accent overlay, so it clears AA on every theme and every accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlineHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource OutlineHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/>
                            <Setter TargetName="label" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- Pressed is a deeper shade of the accent fill (ThemeManager derives
                                 OutlinePressedFillBrush). The old OutlinePressedBrush wash went gray. -->
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlinePressedFillBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource OutlinePressedFillBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/>
                            <Setter TargetName="label" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bare until hover: a title-bar or toolbar button with no face, edge or resting shadow,
         filling with the accent on hover and press like OutlineButton. Its own resources hide the
         rest state, so the template is OutlineButton's. Dialog confirm buttons stay OutlineButton. -->
    <Style x:Key="BareButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="OutlineRestBrush" Color="Transparent"/>
            <Visibility x:Key="OutlineLiftRestVisibility">Collapsed</Visibility>
        </Style.Resources>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Surface Button (secondary): fill one tier lighter than what it sits on, a dim border, and a
         hover that dims rather than colors. Accent on hover belongs to OutlineButton and
         PrimaryButton; a secondary button that lights up accent reads as the primary action. -->
    <!-- ChipFaceBrush: the pane tier on every ordinary theme, a raised #c0c0c0 Win98 button face
         on a flat one. Its hover follows ChipHoverBrush for the same reason. -->
    <Style x:Key="SurfaceButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Background" Value="{DynamicResource ChipFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- ChipEdgeBrush, defaulting to PaneBorderBrush: a button sitting ON a pane takes the
             pane's own edge color (CardBorderBrush is #787878 on Black, which drew a bright gray
             box round every button). 98SE sets it transparent - its bevel is the edge. -->
        <Setter Property="BorderBrush" Value="{DynamicResource ChipEdgeBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Raised: a soft shadow on item-free SIBLINGS under the face (an effect on the face
                             itself would rasterize the caption and lose ClearType). Hover lifts the button
                             higher, press sets it down. BarShadowOpacity is 0 on 98SE, which stays flat. -->
                        <Border x:Name="liftRest" IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Black" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="5" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                        <Border x:Name="liftHover" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Black" Opacity="{DynamicResource BarShadowOpacity}">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="3.5" BlurRadius="10" RenderingBias="Quality"/></Border.Effect>
                        </Border>
                    <Border x:Name="borderRing" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=border}" BorderThickness="{Binding BorderThickness, ElementName=border}" BorderBrush="{Binding Background, ElementName=border}" Margin="{Binding Margin, ElementName=border}" Visibility="{Binding Visibility, ElementName=border}" Opacity="{Binding Opacity, ElementName=border}"/><Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Bar-button edge: a chip on a Win98 bar is FLAT at rest, raises a 1px
                         white/#808080 edge on hover and sinks it on press, like Explorer's toolbar.
                         Both thicknesses are theme tokens that are 0 on every ordinary theme. -->
                    <Border x:Name="tbLight" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource ToolBevelLightThickness}"/>
                    <Border x:Name="tbDark" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource ToolBevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Order matters: IsPressed after IsMouseOver so it wins. -->
                        <!-- A real fill change, not an opacity fade - the fade is invisible on a
                             dark panel and the button reads as dead. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolHoverFaceBrush}"/>
                            <Setter TargetName="tbLight" Property="BorderThickness" Value="{DynamicResource ToolHoverBevelLightThickness}"/>
                            <Setter TargetName="tbDark"  Property="BorderThickness" Value="{DynamicResource ToolHoverBevelDarkThickness}"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="tbLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="tbDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Checked/selected state - same Tag="on" convention and the same
                             SelectionBg/SelectionFg pair every other checkable button style in
                             this file uses (ToolbarButton, RailButton). Declared after
                             IsMouseOver/IsPressed so an "on" row stays reading as ON while
                             hovered rather than fading to the plain hover tint - editors, gear
                             menu toggles (EditorBar.cs SyncEditorGear) and the shell/document
                             bars all set this Tag and had nothing here to answer it, so the
                             menu options were not showing their selected state. -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="liftRest" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="liftHover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextFieldBrush and the selection pair come from the theme: the usual dark field on every
         ordinary theme, a sunken white Win98 field with a recessed bevel on a flat one. -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource TextFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <!-- InputEdgeBrush, not InputBorderBrush: 98SE sets it transparent, because a Win98 field
             is defined by its recessed bevel and a flat line drawn beside it reads as a doubled
             edge. Defaults to InputBorderBrush, so every other theme is unchanged. -->
        <Setter Property="BorderBrush" Value="{DynamicResource InputEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}"/>
        <!-- The text ON a selection. WPF ignores this unless SelectionTextBrush is set, which is
             why 98SE's white-on-navy needs it stated: at 100% selection opacity the default
             leaves the original foreground showing through, i.e. black on navy. -->
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextSelectionTextBrush}"/>
        <Setter Property="SelectionOpacity" Value="{DynamicResource TextSelectionOpacity}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="InputRoot" Tag="{DynamicResource UseDialogCaption}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <input:InputContentHost x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <!-- Recessed field bevel - brushes CROSSED against the thicknesses so it
                         sinks rather than raises. Nothing on any theme but 98SE. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                    <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, ElementName=InputRoot}" Value="True"/>
                                <Condition Binding="{Binding AcceptsReturn, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InputRoot" Property="MinHeight" Value="{DynamicResource CompactInputMinHeight}"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="0"/>
                            <Setter TargetName="PART_ContentHost" Property="CompactPadding" Value="{DynamicResource CompactInputPadding}"/>
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Center"/>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit TextBox style so the search inputs pick up the theme without per-box styling. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>

    <Style x:Key="DialogPickerTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
        <Setter Property="Height" Value="28"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=RootBorder}" Value="True">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="{DynamicResource CompactInputMinHeight}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════ Grunge ComboBox: recessed input face, grain-wrapped themed dropdown. ═══════════ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <!-- Hover text takes precedence when the highlighted row is also selected. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <!-- ComboFieldBrush = BackgroundBrush everywhere but 98SE, where an edit field is a
             WHITE client area - dropdowns are white there. -->
        <Setter Property="Background" Value="{DynamicResource ComboFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <!-- The drop arrow. On every ordinary theme this renders exactly the
                                 bare chevron it always was (transparent face, zero bevels, same
                                 margin); on 98SE it becomes the era's raised gray button filling
                                 the field's right edge, with Marlett's solid triangle - the
                                 dropdown button takes the gray button style. -->
                            <Grid Grid.Column="1" Margin="{DynamicResource ComboChevMargin}" MinWidth="{DynamicResource ComboButtonMinWidth}">
                                <Border Background="{DynamicResource ComboButtonBrush}"/>
                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}" BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}" BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                                <TextBlock x:Name="chev" Text="{DynamicResource ComboChevGlyph}" FontFamily="{DynamicResource ComboChevFont}" FontSize="8"
                                           Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{DynamicResource ComboChevGlyphMargin}"/>
                            </Grid>
                        </Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <!-- ComboPopupBrush: MenuBackgroundBrush everywhere, WHITE on 98SE -
                                 a Win98 dropdown list is a white well with the navy highlight. -->
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource ComboPopupBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Margin="6"
                                    Effect="{DynamicResource ComboPopupShadow}">
                                <Grid>
                                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                    <ScrollViewer Margin="0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

