    <!-- Track and thickness come from the theme: a transparent 12px overlay bar on every ordinary
         theme, a wider Win98 bar with a visible dithered track and a recessed edge on a flat one. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
        <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Three rows: an arrow button at each end and the track between. The arrow
                         rows are ScrollArrowSize high, which is 0 on every ordinary theme - so
                         they collapse to nothing and the bar is the plain overlay it always was.
                         98SE asks for 16 and gets real Win98 stepper buttons. -->
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ArrowUpRow"   Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="ArrowDownRow" Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Columns as well as rows, so ONE template serves both orientations. The
                             steppers used to be laid out in rows only and were simply Collapsed on
                             a horizontal bar, which is why a horizontal Win98 bar had no arrows.
                             Now the Orientation trigger MOVES them: vertical parks them in
                             row 0 / row 2 of column 1, horizontal in column 0 / column 2 of row 1.
                             Both tracks are Auto, so whichever pair is empty measures to zero and
                             the other twelve themes (ScrollArrowSize 0) still get nothing at all. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ArrowLeftCol"  Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ArrowRightCol" Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Marlett, not Segoe MDL2 - the MDL2 scrollbar arrows looked
                             wrong. E70E/E70D are thin CHEVRONS, and at 8px they rendered
                             as a wispy caret with ClearType color fringes. Marlett is the actual
                             Win9x marker font - '5'/'6'/'3'/'4' are the solid up/down/left/right
                             scrollbar triangles - and it is TrueType, so WPF can render it
                             (unlike MS Sans Serif). Aliased, because the real thing was: a 5px
                             triangle drawn through ClearType smears into color. Only 98SE ever
                             sees these buttons (ScrollArrowSize is 0 everywhere else). -->
                        <RepeatButton x:Name="ArrowUp" Grid.Row="0" Grid.Column="1" Command="ScrollBar.LineUpCommand" AutomationProperties.Name="{DynamicResource Str_Scroll_Up}"
                                      Focusable="False" IsTabStop="False"
                                      Width="{DynamicResource ScrollArrowSize}"
                                      Height="{DynamicResource ScrollArrowSize}"
                                      Content="5" FontFamily="Marlett" FontSize="10"
                                      TextOptions.TextRenderingMode="Aliased"
                                      TextOptions.TextFormattingMode="Display"
                                      Foreground="{DynamicResource CaptionGlyphBrush}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource SortButtonBrush}"/>
                                        <Border BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                        <Border BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                        <Border Margin="1" BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                        <Border Margin="1" BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <RepeatButton x:Name="ArrowDown" Grid.Row="2" Grid.Column="1" Command="ScrollBar.LineDownCommand" AutomationProperties.Name="{DynamicResource Str_Scroll_Down}"
                                      Focusable="False" IsTabStop="False"
                                      Width="{DynamicResource ScrollArrowSize}"
                                      Height="{DynamicResource ScrollArrowSize}"
                                      Content="6" FontFamily="Marlett" FontSize="10"
                                      TextOptions.TextRenderingMode="Aliased"
                                      TextOptions.TextFormattingMode="Display"
                                      Foreground="{DynamicResource CaptionGlyphBrush}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource SortButtonBrush}"/>
                                        <Border BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                        <Border BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                        <Border Margin="1" BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                        <Border Margin="1" BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.ViewportSize>
                                <MultiBinding Converter="{StaticResource ThumbFloor}" ConverterParameter="64">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportSize"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Orientation"/>
                                </MultiBinding>
                            </Track.ViewportSize>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" AutomationProperties.Name="{DynamicResource Str_Scroll_PageUp}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" AutomationProperties.Name="{DynamicResource Str_Scroll_PageDown}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Background="Transparent">
                                                        <Border x:Name="thumbBorder" Background="{DynamicResource ScrollThumbBrush}"
                                                                CornerRadius="{DynamicResource ScrollThumbRadius}"
                                                                Margin="{DynamicResource ScrollThumbMargin}"/>
                                                        <!-- Raised thumb bevel: 98SE only. -->
                                                        <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                                        <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                                        <Border IsHitTestVisible="False" Margin="1"
                                                                BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                                        <Border IsHitTestVisible="False" Margin="1"
                                                                BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <!-- ScrollThumbMarginH, not the literal 0,4: that squeeze is the
                                                                 slim-overlay look, and on 98SE it left an 8px thumb floating in
                                                                 a 16px track - the skinny tree scrollbar.
                                                                 The token defaults to exactly the literal it replaced. -->
                                                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbMarginH}"/>
                                                            </DataTrigger>
                                                            <!-- Margin and Effect are theme tokens now (ThemeManager,
                                                                 ScrollThumbHover*): the literals shrank the thumb out from
                                                                 under its own bevel ring and glowed on a shadowless theme.
                                                                 Defaults are exactly the old literals. -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbHoverMargin}"/>
                                                                <Setter TargetName="thumbBorder" Property="Effect" Value="{DynamicResource ScrollThumbHoverEffect}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbHoverMargin}"/>
                                                                <Setter TargetName="thumbBorder" Property="Effect" Value="{DynamicResource ScrollThumbHoverEffect}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- IsDirectionReversed is declared True on the Track above because a
                             VERTICAL track needs it: without it the thumb rises as the content
                             scrolls down. A horizontal track wants the opposite, and one shared
                             template serves both orientations here, so it has to be undone -
                             otherwise the horizontal thumb sits at the right when the content is
                             scrolled hard left, which is what it was doing. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PageBack"    Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="PageBack"    Property="AutomationProperties.Name" Value="{DynamicResource Str_Scroll_PageLeft}"/>
                            <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <Setter TargetName="PageForward" Property="AutomationProperties.Name" Value="{DynamicResource Str_Scroll_PageRight}"/>
                            <!-- The steppers MOVE rather than hiding. They used to be Collapsed
                                 here because the template only had rows, so a horizontal bar would
                                 have put its arrows above and below the track; with the columns
                                 added above they relocate to either end of the track instead, and
                                 a horizontal 98SE bar gets real Win98 steppers like the vertical
                                 one always had. Glyph and command flip with them - Marlett '3'/'4'
                                 are the solid left/right triangles, against '5'/'6' up/down. -->
                            <Setter TargetName="ArrowUp"   Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="ArrowUp"   Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ArrowUp"   Property="Content"     Value="3"/>
                            <Setter TargetName="ArrowUp"   Property="Command"     Value="ScrollBar.LineLeftCommand"/>
                            <Setter TargetName="ArrowUp"   Property="AutomationProperties.Name" Value="{DynamicResource Str_Scroll_Left}"/>
                            <Setter TargetName="ArrowDown" Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="ArrowDown" Property="Grid.Column" Value="2"/>
                            <Setter TargetName="ArrowDown" Property="Content"     Value="4"/>
                            <Setter TargetName="ArrowDown" Property="Command"     Value="ScrollBar.LineRightCommand"/>
                            <Setter TargetName="ArrowDown" Property="AutomationProperties.Name" Value="{DynamicResource Str_Scroll_Right}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- ScrollBarThickness, not a literal 12: 98SE asks for a 16px bar and the
                     horizontal one stayed 12 while the vertical one grew, so the two disagreed
                     and the corner block never squared up. -->
                <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="MinHeight" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <!-- Display + Grayscale on the menu itself, as KillerPDF sets on every menu it builds. The window's ClearType is inherited into a menu otherwise, and a menu lives in a transparent popup where ClearType cannot render, so the labels are left to a fallback instead of asking for antialiasing. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <!-- Compensates the shadow halo so a menu lands where it did when that halo was 5 (this
             template) or 6 (FlyoutCard). Those two differ by a pixel, so the rail flyouts sit
             1px off their old spot; the menus are exact. -->
        <Setter Property="HorizontalOffset" Value="-17"/>
        <Setter Property="VerticalOffset" Value="-13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin leaves room for the drop shadow to render inside the popup.
                         FADE IN: a ContextMenu has no PopupAnimation property - it is not a
                         Popup, it is hosted inside one WPF owns - so the fade is driven from
                         the template with an EventTrigger on Loaded. The SubPopup below already
                         sets PopupAnimation="Fade", so a menu appeared instantly while its own
                         children faded in, which is backwards. 150ms ease-out. -->
                    <!-- Radius 6 = the family flyout card (FlyoutCard above); the grain overlay
                         takes 5, the card's 6 minus its 1px border, so the texture stops exactly
                         inside the frame. -->
                    <!-- Halo sized to the 22/4 shadow below, the family flyout value: WPF expands
                         render bounds by the FULL BlurRadius, so 22 each way, less the 4px lift
                         off the top and plus it on the bottom. The offsets on the style above
                         hold the card in place against the wider halo. -->
                    <Grid x:Name="MenuRoot" Opacity="0" Margin="22,18,22,26">
                        <!-- Shadow-only layer behind, so the menu text stays crisp. -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource PanelCornerRadius}">
                            <Grid>
                                <!-- Film grain on the menu surface, matching the settings panel. -->
                                <!-- IsSharedSizeScope so every MenuItem's Header/Gesture columns in THIS
                                     popup align as real columns (see the MenuItem template's SharedSizeGroup
                                     names) instead of each row sizing its shortcut text independently. -->
                                <!-- A menu taller than the screen scrolls instead of cutting off its last items (KillerShot menu-overflow). -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <StackPanel IsItemsHost="True" Margin="{TemplateBinding Padding}" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                Grid.IsSharedSizeScope="True"/>
                                </ScrollViewer>
                                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                                        CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}"/>
                            </Grid>
                        </Border>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource MenuBevelInnerMargin}" BorderBrush="{DynamicResource MenuBevelLightBrush}" BorderThickness="{DynamicResource MenuBevelLightThickness}"/>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource MenuBevelInnerMargin}" BorderBrush="{DynamicResource MenuBevelDarkBrush}" BorderThickness="{DynamicResource MenuBevelDarkThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2LightBrush}" BorderThickness="{DynamicResource MenuBevel2LightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2DarkBrush}" BorderThickness="{DynamicResource MenuBevel2DarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Menu icon glyph: Segoe MDL2 at 12, left-aligned in the 16px gutter. The 2026-08-09
         selection/hover color language: icons rest on the plain text color and go accent with
         the hovered row - never accent at rest, never accent on an accent fill. The hover
         brush is ComboHighlightTextBrush rather than PrimaryBrush for the 98SE navy-wash
         reason documented on the MenuItem template below. -->
    <Style x:Key="MenuGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ported wholesale from KillerPDF's MenuItem template (MainWindow.xaml), brush names
         translated. What changed from KillerShell's own version:
           - Padding 24,7 -> 8,6,10,6. The old row carried 24px of padding IN FRONT of a 28px
             icon gutter, so text started roughly twice as far in as KillerPDF's.
           - Icon gutter: an Auto column holding an 18px presenter plus a 10px margin -> a fixed
             16px column, which is also the check-glyph column. Items with no icon no longer
             collapse the gutter, so every row's text lines up whether or not it has an icon.
           - Highlight gets CornerRadius 3 instead of a square block running edge to edge, and
             no longer recolors the text to the accent - KillerPDF moves the background only.
           - InputGestureText column and submenu arrow: KillerShell's template had NEITHER, so a
             shortcut hint on a menu item silently rendered nothing and a submenu had no
             affordance. Both are here now, with the same collapse-when-empty trigger.
           - Submenu popup mirrors the ContextMenu surface, with the same background and grain. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource MenuItemPadding}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuBd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <!-- Header and Gesture are Auto + SharedSizeGroup, not Header="*", so the
                                     shortcut text starts at the SAME x-offset in every sibling row (a real
                                     column) instead of hugging the right edge of whichever row is widest. -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuHeaderCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureCol"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon slot: MenuItem.Icon renders in the same 16px gutter the check
                                 glyph uses (MakeMenuItem's glyph parameter fills it with MDL2 icons). -->
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <!-- check glyph for checkable items (e.g. OCR language multi-select) -->
                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <!-- submenu arrow for items that have children -->
                            <TextBlock x:Name="SubArrow" Grid.Column="3" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalOffset="-2" VerticalOffset="-3" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <!-- WPF places the child render bounds; the outer halo needs no offset.
                                      Native row-relative placement retains handedness and edge flipping. -->
                                <Grid Margin="22,18,22,26">
                                    <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource FlyoutCornerRadius}" IsHitTestVisible="False">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource MenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource FlyoutCornerRadius}">
                                        <Grid>
                                            <!-- Own scope, so a submenu's columns align among its own
                                                 siblings rather than the unrelated parent popup's rows. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                                <ItemsPresenter Margin="4" Grid.IsSharedSizeScope="True"/>
                                            </ScrollViewer>
                                            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                                                    CornerRadius="{DynamicResource FlyoutCornerRadius}" Background="{DynamicResource GrainTileBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Border IsHitTestVisible="False" Margin="{DynamicResource MenuBevelInnerMargin}" BorderBrush="{DynamicResource MenuBevelLightBrush}" BorderThickness="{DynamicResource MenuBevelLightThickness}"/>
                                    <Border IsHitTestVisible="False" Margin="{DynamicResource MenuBevelInnerMargin}" BorderBrush="{DynamicResource MenuBevelDarkBrush}" BorderThickness="{DynamicResource MenuBevelDarkThickness}"/>
                                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2LightBrush}" BorderThickness="{DynamicResource MenuBevel2LightThickness}"/>
                                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2DarkBrush}" BorderThickness="{DynamicResource MenuBevel2DarkThickness}"/>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover uses the menu wash and its contrast text brush. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuBd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                            <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                            <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource MenuHoverTextBrush}"/>
                        </Trigger>
                        <!-- Collapse the shortcut column when there is no gesture, so items without a
                             shortcut do not reserve its 24px left margin as phantom right padding. -->
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static kl:ShortcutHints.Current}, Path=Enabled}" Value="False">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MenuBd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NOTE: inside a Menu or ContextMenu, WPF does NOT use this implicit style - it looks up
         MenuItem.SeparatorStyleKey and falls back to the stock Aero separator, the bright gray
         3D line. That is what the caption system menu was showing between Maximize and Close
         (SystemMenu.cs adds a Separator there). The keyed alias just below is what
         actually applies in menus; this one covers separators used anywhere else. -->
    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The key WPF actually resolves for a Separator sitting in a menu. Same look as above;
         registering it here is what stops the stock light-gray line. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}"/>
    </Style>

    <!-- Glyph for a MenuItem.Icon, so an icon in the new gutter is one line at the call site
         and the size lives in one place (family standard, from KillerScan).
         No Foreground here on purpose. The colour is inherited from the menu item, which is what
         lets the highlighted state change it with the row's text in every menu style: a style
         setter here would outrank that, and an ancestor-bound IsHighlighted trigger does not
         reliably resolve through MenuItem.Icon, so the glyph kept its resting colour and went
         black-on-navy under the 98SE highlight. -->
    <Style x:Key="MenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- ============================================================
         Family flyout standard, ported verbatim from KillerPDF - the exact KillerPDF menu is
         the reference for everything here. The rail's theme and language flyouts are
         Button.ContextMenus whose chrome comes ONLY from FlyoutCard + FlyoutGrain, with
         PanelMenuItem stripping the MenuItem container for panel content (a StackPanel of
         RadioButtons, not clickable rows).
         ============================================================ -->

    <!-- The card: fill, frame, radius, shadow-room margin and the shadow itself. -->
    <Style x:Key="FlyoutCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
        <!-- Margin is the room the drop shadow renders into: a Popup clips to its own bounds, so
             anything the shadow throws past it is cut off square. Sized to FlyoutCardEffect's 22/4:
             WPF expands render bounds by the FULL BlurRadius, so 22 each way, less the 4px lift off
             the top and plus it on the bottom. CONSUMERS MUST COMPENSATE with
             HorizontalOffset/VerticalOffset - see the ContextMenu style. -->
        <Setter Property="Margin" Value="22,18,22,26"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- FlyoutCardEffect: CardShadowEffect on every ordinary theme exactly as before, and a
             HARD offset shadow on 98SE - Win98 drew its menus with a solid drop shadow, so the
             flyouts get it back with the bevel. -->
        <Setter Property="Effect" Value="{DynamicResource FlyoutCardEffect}"/>
    </Style>

    <!-- The grain overlay. LAST child of the card, so it lies OVER the items - including a
         highlighted row's solid SelectionBg fill. Radius 5 = the card's 6 minus its 1px
         border, so the texture stops exactly inside the frame. -->
    <Style x:Key="FlyoutGrain" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource GrainTileBrush}"/>
        <Setter Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
    </Style>

    <!-- ItemContainerStyle for a flyout whose content is a PANEL (swatches, radio lists)
         rather than rows you click. Strips the MenuItem container down to its content: no
         hover highlight bleeding across the card, no icon gutter. -->
    <Style x:Key="PanelMenuItem" TargetType="MenuItem">
        <Setter Property="Padding" Value="0"/>
        <!-- A click inside the panel that bubbles up to this container counts as a MenuItem
             click and closes the flyout without this. The theme flyout must survive a pick so
             themes can be compared; the language flyout closes itself explicitly either way. -->
        <Setter Property="StaysOpenOnClick" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent picker dot, family-standard (KillerPDF AccentDot). 18px filled circle, rings
         in TextBrush when it is the family's current pick (set from code). -->
    <Style x:Key="AccentDot" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AccentSwatchCornerRadius}"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Ringed radio row for the theme/language flyouts (KillerPDF ThemeRadio). PrimaryBrush
         stands in for PDF's RadioAccent, which KillerShell has no separate resource for. -->
    <Style x:Key="ThemeRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Transparent ROW, not RadioWellBrush: that key is the little white circle
                         well behind the radio RING (see KillerNotes' copy of this template), and
                         painting it across the whole row turned every flyout option into a WHITE
                         pill on 98SE - the "wrong color" flyouts. The well
                         ellipse below is where it actually belongs; both are transparent on every
                         ordinary theme, so nothing changes there. -->
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="3"
                            Margin="-8,0,2,0" Padding="10,4,10,4">
                        <!-- DockPanel (not a horizontal StackPanel) so the content fills the row
                             width, letting a right-aligned column (e.g. language codes) reach the
                             right edge. -->
                        <DockPanel LastChildFill="True" Background="Transparent">
                            <!-- Centered on the label's capitals for whatever font the theme uses (Controls/CapCenterMargin.cs). A fixed nudge only fits one face. -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Grid.Margin><MultiBinding Converter="{x:Static kl:CapCenterMargin.Instance}" ConverterParameter="0,0,8,0"><Binding RelativeSource="{RelativeSource TemplatedParent}" Path="FontFamily"/><Binding RelativeSource="{RelativeSource TemplatedParent}" Path="FontSize"/></MultiBinding></Grid.Margin>
                                <Ellipse Width="14" Height="14" Fill="{DynamicResource RadioWellBrush}"/>
                                <Ellipse x:Name="ring" Width="14" Height="14"
                                         Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.5"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="dot" Width="6" Height="6"
                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <!-- Hovered: the ring takes RadioHoverFgBrush, which ThemeManager aliases
                             to PrimaryBrush so twelve themes are unchanged. Sepulchre's accent IS
                             its hover fill, so it sets the key to white or the ring vanishes. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <!-- Checked AND hovered: dot and label follow the same key. Declared last
                             so it wins both single triggers. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource RadioHoverFgBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ThemeRadio's square sibling for on/off switches in the theme flyout (Film Grain): the same row, hover and accent, with a box and checkmark in place of the ring and dot. Derived from this file's ThemeRadio, as KillerPDF's ThemeCheck is from its own. -->
<Style x:Key="ThemeCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="3"
                            Margin="-8,0,2,0" Padding="10,4,10,4">
                        <DockPanel LastChildFill="True" Background="Transparent">
                            <!-- Centered on the label's capitals for whatever font the theme uses (Controls/CapCenterMargin.cs). A fixed nudge only fits one face. -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Grid.Margin><MultiBinding Converter="{x:Static kl:CapCenterMargin.Instance}" ConverterParameter="0,0,8,0"><Binding RelativeSource="{RelativeSource TemplatedParent}" Path="FontFamily"/><Binding RelativeSource="{RelativeSource TemplatedParent}" Path="FontSize"/></MultiBinding></Grid.Margin>
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Width="14" Height="14" Background="{DynamicResource RadioWellBrush}"/>
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" x:Name="ring" Width="14" Height="14"
                                         BorderBrush="{DynamicResource DimTextBrush}" BorderThickness="1"
                                         Background="Transparent"/>
                                <Grid Width="14" Height="14" IsHitTestVisible="False"><Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/><Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/><Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/><Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/></Grid>
<TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" x:Name="dot"
                                         Foreground="{DynamicResource PrimaryBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter TargetName="dot" Property="Foreground" Value="{DynamicResource RadioHoverFgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource RadioHoverFgBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeSwatch" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="StrokeThickness" Value="2"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="dot" Property="StrokeThickness" Value="3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width row inside a popup menu: transparent until hovered, then the menu's own
         hover fill. Needed because a Button with no Style keeps the default WPF template, whose
         hover is the system light blue - setting Background alone does not reach it, since the
         template's own trigger paints over whatever the property says. -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed"   Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact horizontal slider. The default WPF Slider brings its own chrome, tick bar and
         system colors, none of which belong on a themed card - so the template is a thin track
         with an accent fill up to the thumb, and a small round grip. The fill is a second Border
         inside the same cell driven by the RepeatButton's width, which is what actually reports
         the value's position without a converter. -->
    <Style x:Key="ThinSlider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- SliderTrack: the input edge on every ordinary theme, a #808080 sunken
                             groove on 98SE. -->
                        <Border Height="3" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                Background="{DynamicResource SliderTrack}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                                    Background="{DynamicResource PrimaryBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Grip" Width="13" Height="13" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="knob" Fill="{DynamicResource PrimaryBrush}"
                                                     Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="StrokeThickness" Value="1"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="DangerRed" Color="#e04444"/>
    <!-- Fixed, non-theme status colors, alongside DangerRed above - a severity dot has to read
         the same regardless of which theme or accent is active, the way DangerRed already does
         for a Processes tab. Added for the Event Viewer's Level column (Tools/EventViewerControl.cs). -->
    <SolidColorBrush x:Key="WarningAmber" Color="#e0a83f"/>
    <SolidColorBrush x:Key="InfoBlue" Color="#4a90d9"/>

    <!-- Geometry and face come from the theme (ThemeManager's 98SE chrome contract), not from
         literals: 44x36 with a transparent face and a row-hover wash on every ordinary theme, and
         a short beveled Win98 button with a real face and no hover on a flat one. Bound, so
         98SE needs no branch and no second style. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Background" Value="{DynamicResource CaptionButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptionGlyphBrush}"/>
        <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="{DynamicResource CaptionButtonMargin}"/>
        <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}"/>
        <Setter Property="Height" Value="{DynamicResource CaptionButtonHeight}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <!-- Raised bevel. Zero-thickness and transparent on every theme but 98SE,
                             so it costs nothing and draws nothing there. -->
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/></Trigger>
                        <!-- Snap layouts put the maximize button in the non-client area, where WPF
                             sees no mouse, so SnapLayouts reports the hover itself. -->
                        <Trigger Property="snap:SnapLayouts.IsHovered" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main-window close button: the WHOLE button fills danger red with a white glyph on
         hover, like KillerPDF's. The dialog close X's keep the glyph-only treatment. -->
    <!-- Inherits geometry and the bevel from ChromeButton; only the corner and the hover differ.
         On a flat theme it is a beveled gray button with a black glyph and NO hover fill, which
         is how Win98 drew it - it reacted to being pressed, not hovered. -->
    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Foreground" Value="{DynamicResource CaptionCloseBrush}"/>
        <Setter Property="Margin" Value="{DynamicResource CaptionCloseGap}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- The corner follows the WINDOW's radius: this button sits IN the
                             top-right corner, so a square red fill runs past the curve and the
                             DWM slices the overhang off, leaving a chewed edge on hover. Squares
                             itself on a flat theme, where the window is square too. -->
                        <Border x:Name="Bd" Background="{DynamicResource CaptionButtonBrush}"
                                CornerRadius="{DynamicResource CaptionCloseCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bevelLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <Border x:Name="bevelInnerLight" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                        <Border x:Name="bevelOuterDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverFgBrush}"/>
                        </Trigger>
                        <!-- PRESSED: the bevel inverts, so the button visibly sinks. That is the
                             only feedback a Win98 caption button ever gave - it had no hover
                             state at all. Both bevels are zero-thickness on
                             every other theme, so this trigger does nothing there. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelOuterDarkBrush}"/>
                            <Setter TargetName="bevelDark"  Property="BorderBrush" Value="{DynamicResource BevelInnerLightBrush}"/>
                            <Setter TargetName="bevelInnerLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelOuterDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A check-marked option row for the editor's gear and encoding popups: reads like a
         MenuItem - transparent row, hover wash, a 16px check column that shows E73E while
         Tag="on" - instead of the accent-filled buttons these were, which read as pressed
         buttons rather than toggled options. The Tag="on" signal is the
         SAME one the code already sets for SurfaceButton, so no code changes anywhere. -->
    <Style x:Key="CheckRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="4,3,10,3">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="check" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" Width="16" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close X for the About card and the Shortcuts card. Theme-split entirely through tokens
         (AboutClose* in ThemeManager): on every ordinary theme it renders the ORIGINAL treatment
         - a bare muted U+2715 that reddens on hover, no fill - and on 98SE it is a real Win98
         caption button: gray beveled face, black bold E8BB, sinks on press, no hover state.
         ChromeCloseButton was tried here first and dragged the main window's red hover fill and
         glyph onto the cards, which read wrong on the ordinary themes. -->
    <Style x:Key="OverlayCloseButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AboutCloseFg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AboutCloseFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource CaptionButtonBrush}"/>
                        <Border x:Name="bevelLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <Border x:Name="bevelInnerLight" IsHitTestVisible="False" Margin="{DynamicResource BevelInnerMargin}"
                                BorderBrush="{DynamicResource BevelInnerLightBrush}" BorderThickness="{DynamicResource BevelInnerLightThickness}"/>
                        <Border x:Name="bevelOuterDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelOuterDarkBrush}" BorderThickness="{DynamicResource BevelOuterDarkThickness}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AboutCloseHoverFg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelOuterDarkBrush}"/>
                            <Setter TargetName="bevelDark"  Property="BorderBrush" Value="{DynamicResource BevelInnerLightBrush}"/>
                            <Setter TargetName="bevelInnerLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelOuterDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevation (KillerPDF ShadowBar): lifts panels/cards slightly off the surface. -->
    <DropShadowEffect x:Key="ShadowBar" Color="Black" BlurRadius="6" ShadowDepth="3" Direction="270" Opacity="0.38"/>
    <!-- Stronger elevation for the results pane; casts down over the footer. -->
    <!-- Kept for anything still referencing it directly. The LIVE one is PaneShadowEffect, built
         per palette load in ThemeManager at that theme's PaneShadowOpacity and set to NULL on a
         flat theme - 98SE has no shadows at all. A StaticResource here could never follow a theme
         change, which is why the pane kept its shadow on 98SE. -->
    <DropShadowEffect x:Key="PaneShadow" Color="Black" BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.6"/>

    <!-- Themed checkbox: small square, accent check, mono label. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Grid x:Name="box" DockPanel.Dock="Left" Width="15" Height="15" VerticalAlignment="Center">
                            <Border x:Name="boxFace" CornerRadius="{DynamicResource SmallCornerRadius}"
                                    Background="{DynamicResource CheckBoxBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="1"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                    BorderThickness="{DynamicResource CheckBoxSunkenDarkThickness}"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                    BorderThickness="{DynamicResource CheckBoxSunkenLightThickness}"/>
                            <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                    BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                                    BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                            <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                    BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                                    BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource CheckBoxGlyphSize}"
                                       Foreground="{DynamicResource CheckBoxCheckBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Effect="{DynamicResource TextStrokeSoft}"/>
                        </Grid>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="boxFace" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="boxFace" Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}"/>
                            <Setter TargetName="boxFace" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBorderBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- KillerUI sidebar icon-rail button: bare
         glyph with a soft shadow, turning the accent color on hover. Set Content to the glyph;
         override FontFamily/FontSize for text glyphs like a "?" button. -->
    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- 20 logical hugs the 16px glyphs; the RailW=24 column (SearchPanel.cs) leaves only a
             2px inset per side, so zooming scales the icons rather than blank strip. -->
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Grid>
                            <!-- Light/Yellow: the active or hovered glyph shows the yellow accent with the wordmark's
                                 dark halo behind it, so it reads on white. WordmarkAccentShadowOpacity is 0 on every
                                 other theme, which leaves both extra layers invisible. -->
                            <TextBlock kl:GlyphInk.Center="True" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D8000000" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.RenderTransform><TranslateTransform X="1" Y="2"/></TextBlock.RenderTransform><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock kl:GlyphInk.Center="True" Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="270"
                                                      Opacity="{DynamicResource IconShadowOpacity}"/>
                                </TextBlock.Effect>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <!-- Tag="on" marks a rail toggle whose panel is open. -->
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock kl:GlyphInk.Center="True" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentLogo}" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- View-mode toggles (results pane list / icons / details). Tag="on" marks the active one,
         the same convention the folder picker's own strip uses. -->
    <Style x:Key="ViewToggleBtn" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource SortButtonBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Toolbar button edge: a Win98 toolbar button is FLAT at rest, raises a
                             1px white/#808080 edge on hover and sinks it on press. The rest and
                             hover thicknesses are theme tokens that are 0 on every ordinary theme,
                             so nothing draws there; 98SE states 0 at rest and 1px on hover. -->
                        <Border x:Name="tbLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource ToolBevelLightThickness}"/>
                        <Border x:Name="tbDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource ToolBevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover = accent glyph on the neutral wash (2026-08-09 color language).
                             Declared BEFORE Tag="on" so a hovered SELECTED button keeps white-on-
                             accent - the later trigger wins the Foreground, never accent-on-accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ToolHoverFaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="tbLight" Property="BorderThickness" Value="{DynamicResource ToolHoverBevelLightThickness}"/>
                            <Setter TargetName="tbDark"  Property="BorderThickness" Value="{DynamicResource ToolHoverBevelDarkThickness}"/>
                        </Trigger>
                        <!-- PRESSED: the hover edge inverts so the button sinks. Inert off 98SE,
                             where both thicknesses are 0. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tbLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="tbDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Details-view column header buttons: a label plus a sort arrow, flat until hovered. -->
    <Style x:Key="ColHeaderBtn" TargetType="Button">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ FOLDER TREE ═══════════ -->
    <!-- The stock WPF TreeView brings its own chrome with it: a white SystemColors selection
         highlight, Aero triangles, and a ScrollViewer whose corner square between the two
         scrollbars is painted with the system Control brush - the white box that showed up at
         the end of the horizontal bar. All three are replaced here rather than patched. -->

    <!-- Expander triangle. A Path rather than a glyph font so it stays crisp at any app
         scale and takes the accent on hover like everything else. -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <!-- Canvas so the geometry coordinates below are absolute within the
                             16px gutter and line up with the connecting line, which sits at
                             x=7.5-8.5. A bare Path would be positioned by layout instead, and
                             the alignment this whole style exists for would drift.
                             The connector has its own gap, so the arrow needs no painted mask
                             and the actual theme surface remains visible behind it. -->
                        <Canvas Width="16" Height="16">
                            <Path x:Name="arrow" Data="M 8.5,3.5 L 13,7.5 L 8.5,11.5"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource DimTextBrush}" SnapsToDevicePixels="False"/>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Points down, vertex landing on x=8 - the line's center - so the
                                 line runs into the point of the V rather than off to one side.
                                 Arm length and angle match the collapsed chevron (these are its
                                 own three points rotated 90 degrees, worked out by hand: a
                                 RenderTransform cannot be reached by TargetName, MC4111). -->
                            <Setter TargetName="arrow"     Property="Data" Value="M 4,5.25 L 8,9.75 L 12,5.25"/>
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- 2,0 (was 2,1), matching the saved places' own compaction: the tree is a dense index
             you scan down, and with the row's StackPanel margin also dropped a row is the same
             height in both halves of the sidebar. -->
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 16px gutter carries the expander AND the connecting lines, so
                                 the lines land dead center on the triangle at every depth. -->
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Connecting lines. The vertical runs the full height of the node and
                             its children; the horizontal is the stub out to this node's icon.
                             For the last child the vertical is cut to an elbow (see trigger)
                             so it stops at the join instead of trailing into empty space. -->
                        <Grid Grid.Row="0" Width="1" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="VerLineTop" Grid.Row="0" Margin="0,0,0,4"
                                       Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>
                            <Rectangle x:Name="VerLineBottom" Grid.Row="1" Margin="0,4,0,0"
                                       Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>
                        </Grid>
                        <Rectangle x:Name="VerLineTail" Grid.Row="1" Width="1" HorizontalAlignment="Center"
                                   Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>
                        <!-- Only drawn for a node with no expander. Where there IS one the
                             chevron is the connector - its tips meet the vertical line at x=8
                             and it carries the eye out to the icon, so a stub underneath it
                             would just be the line showing through the arms again. -->
                        <Rectangle x:Name="HorLine" Height="1" Margin="8,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>

                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}"
                                      ClickMode="Press" VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <Border x:Name="Bd" Grid.Column="1" CornerRadius="{DynamicResource SmallCornerRadius}" Margin="2,0,0,0"
                                Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- No children means no chevron, so the elbow stub takes over as the
                             connector. The vertical stays either way: a leaf still belongs to
                             the run of siblings drawn down the gutter. -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="HorLine" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="VerLineTop" Property="Margin" Value="0"/>
                            <Setter TargetName="VerLineBottom" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <!-- SelectionBg + SelectionFg, the SAME pair the places/bookmarks rows
                             use - the tree used RowSelectedBrush, which on Delirium, Sepulchre,
                             Malaise, Decay and Ectoplasm is a gray wash while the bookmarks
                             below glow the accent, and the mismatch read as a bug - the tree
                             should light the accent too. One selection treatment
                             everywhere; the trees' item templates must NOT pin their own
                             Foreground or the Fg half cannot reach the text. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                        <!-- Last sibling: cut the vertical to an elbow. Bound to the container
                             itself so a recycled container re-evaluates (LastChildConverter.cs). -->
                        <DataTrigger Value="True"
                                     Binding="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource IsLastChild}}">
                            <Setter TargetName="VerLineTail" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="VerLineBottom" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource IsLastChild}}" Value="True"/>
                                <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="VerLineBottom" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="VerLineBottom" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="VerLineBottom" Property="Height" Value="3"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer with NO corner element. The stock template puts a Rectangle in the gap
         where the two scrollbars meet, filled with SystemColors.ControlBrushKey - white in
         every theme this app ships, and the little square that kept showing up at the end of
         the horizontal bar. Retemplating the TreeView alone did not remove it: the TreeView's
         template still hosted a plain ScrollViewer, which brings its own default template and
         the corner with it. The cell is simply left empty here. -->
    <Style x:Key="BareScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="ViewportFadeHost" Grid.Row="0" Grid.Column="0">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"/>
                        </Border>

                        <!-- The PART_ names are what ScrollViewer wires its own scrolling to, so
                             Value binds one-way and the control drives it from there. -->
                        <!-- RowSpan 2: the vertical bar runs down THROUGH the corner block rather
                             than stopping above it. The corner was a bare 16x16 hole whenever a
                             horizontal bar appeared, and the only thing that sensibly fills it is
                             the bar itself. -->
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                   Orientation="Vertical" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>

                        <!-- Row 1 / Column 1 deliberately left empty: that is the corner. -->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SCROLL EDGE SHADOWS for the file browser and Performance. KillerScan 1.8.0 is the
         reference: a dark gradient at an edge only while more content lies past it. The cues
         span the scrollbar column and row and the bars draw above them, so the shadow runs
         underneath the scrollbars out to the pane edges. List spacing belongs in the
         ScrollViewer's Padding, inside the scrolling content, so the shadow is not inset by it.
         EdgeFadeOpacity is 0 on 98SE, which has no shadows. -->
    <kui:ScrollEdgeVisibilityConverter x:Key="ScrollEdgeVisibility"/>
    <Style x:Key="ScrollCueBase" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="{DynamicResource EdgeFadeOpacity}"/>
        <Setter Property="Panel.ZIndex" Value="99"/>
    </Style>
    <!-- The top cue draws no rule of its own: under a content border, a 1px rule along the
         clipped edge doubled that border while scrolled. A host with no border above it (the
         Shortcuts card) asks for one through the viewer's BorderThickness. -->
    <Style x:Key="ScrollTopCue" TargetType="Border" BasedOn="{StaticResource ScrollCueBase}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80000000" Offset="0"/>
                    <GradientStop Color="#38000000" Offset="0.35"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="ScrollBottomCueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#38000000" Offset="0.65"/>
        <GradientStop Color="#80000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- A list over a bottom tab strip hides this (FilePane.xaml.cs ApplyBottomTabShadow) while
         the pane's TabScrollShadow overlay draws the same shadow on into the active tab. -->
    <Style x:Key="ScrollBottomCue" TargetType="Border" BasedOn="{StaticResource ScrollCueBase}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBottomCueBrush}"/>
    </Style>
    <Style x:Key="ScrollLeftCue" TargetType="Border" BasedOn="{StaticResource ScrollCueBase}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#38000000" Offset="0.65"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollRightCue" TargetType="Border" BasedOn="{StaticResource ScrollCueBase}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#38000000" Offset="0.65"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BareScrollViewer's layout (no corner block, the vertical bar runs through the corner)
         with the four edge cues under the bars. -->
    <Style x:Key="ShadowScrollViewer" TargetType="ScrollViewer">
        <!-- The viewer draws no border of its own; BorderBrush and BorderThickness are the top
             cue's rule, none by default, so a host with no border above it can ask for one and
             give it a gradient on a gradient surface (the Shortcuts card). -->
        <Setter Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ScrollTopCue}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource ScrollEdgeVisibility}" ConverterParameter="Start">
                                    <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Visibility>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource ScrollBottomCue}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource ScrollEdgeVisibility}" ConverterParameter="End">
                                    <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Visibility>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource ScrollLeftCue}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource ScrollEdgeVisibility}" ConverterParameter="Start">
                                    <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Visibility>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource ScrollRightCue}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource ScrollEdgeVisibility}" ConverterParameter="End">
                                    <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Visibility>
                        </Border>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Panel.ZIndex="100"
                                   Orientation="Vertical" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Panel.ZIndex="100"
                                   Orientation="Horizontal" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTreeView" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderTreeItem}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                        <ScrollViewer Style="{StaticResource BareScrollViewer}"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File and folder picker internals: row container, text tiers, view-toggle and
     column-header buttons, and the view templates with their panels. -->

    <!-- The places / bookmarks rail. Same behavior as PickerRow but tight: PickerRow's 8,5 padding
         plus 2,1 margin made each place about 28px tall around a 16px icon, so the rail showed far
         fewer entries than it had room for. Its own style, because the file list uses PickerRow for
         rows carrying three columns of detail that need the breathing room. -->
    <Style x:Key="PickerPlaceRow" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="6,1" Margin="2,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row container: hover + accent selection. -->
    <Style x:Key="PickerRow" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,5" Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryFillBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Picker selection changes the row colors without filtering its text or icons. -->
    <Style x:Key="PickerRowContent" TargetType="Panel"/>

    <!-- Glyph: accent for folders, dim for files, white while selected. -->
    <Style x:Key="PickerGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Entry name: normal for folders, muted for files, white while selected. -->
    <Style x:Key="PickerName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Size / modified columns in details view. -->
    <Style x:Key="PickerMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- View toggle buttons; Tag="on" marks the active mode. -->
    <Style x:Key="PickerViewBtn" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource SortButtonBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Toolbar button edge: a Win98 toolbar button is FLAT at rest, raises a
                             1px white/#808080 edge on hover and sinks it on press. The rest and
                             hover thicknesses are theme tokens that are 0 on every ordinary theme,
                             so nothing draws there; 98SE states 0 at rest and 1px on hover. -->
                        <Border x:Name="tbLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource ToolBevelLightThickness}"/>
                        <Border x:Name="tbDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource ToolBevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover = accent glyph on the neutral wash (2026-08-09 color language).
                             Declared BEFORE Tag="on" so a hovered SELECTED button keeps white-on-
                             accent - the later trigger wins the Foreground, never accent-on-accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ToolHoverFaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="tbLight" Property="BorderThickness" Value="{DynamicResource ToolHoverBevelLightThickness}"/>
                            <Setter TargetName="tbDark"  Property="BorderThickness" Value="{DynamicResource ToolHoverBevelDarkThickness}"/>
                        </Trigger>
                        <!-- PRESSED: the hover edge inverts so the button sinks. Inert off 98SE,
                             where both thicknesses are 0. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tbLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="tbDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sortable column header buttons (details view). -->
    <Style x:Key="PickerColBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LIST view row: real 16px shell icon + name, sized so columns line up when the panel
         wraps vertically. Fixed Width is what makes the columns even; without it every column
         is as wide as its longest name and the grid looks ragged. -->
    <DataTemplate x:Key="RowTemplate">
        <StackPanel Orientation="Horizontal" Style="{StaticResource PickerRowContent}" Width="210">
            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                   Margin="0,0,8,0" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ICONS view: 32px icon above a centered, wrapping name. Genuinely different from the
         list view - previously both used RowTemplate and only the panel differed, which read
         as two list modes. -->
<DataTemplate x:Key="IconTemplate">
        <StackPanel Style="{StaticResource PickerRowContent}" Width="{DynamicResource PickerIconContentWidth}">
            <Image Source="{Binding IconLarge}" Width="{DynamicResource PickerIconSize}" Height="{DynamicResource PickerIconSize}"
                   HorizontalAlignment="Center" Margin="0,2,0,4" SnapsToDevicePixels="True"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxHeight="30"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- Details view: name | size | modified. -->
    <DataTemplate x:Key="DetailsTemplate">
        <Grid Style="{StaticResource PickerRowContent}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                       Margin="0,0,8,0" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource PickerMeta}" TextAlignment="Right" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding ModifiedLabel}" Style="{StaticResource PickerMeta}" Margin="10,0,0,0"/>
        </Grid>
    </DataTemplate>

<!-- Details view: one row per entry, scrolls down. -->
    <ItemsPanelTemplate x:Key="PanelStack"><VirtualizingStackPanel/></ItemsPanelTemplate>

    <!-- LIST view: fills a column top-to-bottom then starts the next column to the right, so
         the pane scrolls HORIZONTALLY - Explorer's List view. Vertical
         orientation is what makes it wrap downward-then-across; the ListBox must also have
         VerticalScrollBarVisibility="Disabled" or the panel gets infinite height and never
         wraps at all. ItemHeight keeps the columns aligned. -->
    <ItemsPanelTemplate x:Key="PanelListCols">
        <WrapPanel Orientation="Vertical" ItemHeight="26"/>
    </ItemsPanelTemplate>

    <!-- ICONS view: left-to-right, wrapping down, scrolls vertically. -->
<ItemsPanelTemplate x:Key="PanelIconGrid">
        <WrapPanel Orientation="Horizontal" ItemWidth="{DynamicResource PickerIconTileWidth}" ItemHeight="{DynamicResource PickerIconTileHeight}"/>
    </ItemsPanelTemplate>

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID  -  KillerScan's DataGrid styling (MainWindow.xaml), ported rather than
         reinvented: this is the FIRST DataGrid in KillerShell (Tools/ProcessListControl.cs, the
         Task Manager tab's process list), so the row/cell/header treatment lives here rather
         than beside that one call site - any future grid in the app reuses these three keys
         instead of growing its own. Every brush is one already themed elsewhere in the app
         (TableHeaderBrush, MutedTextBrush, HeaderLineBrush, RowHoverBrush, RowAltBrush,
         RowSelectedBrush, PrimaryBrush, TextBrush) - nothing new was added to the palette.
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
        <!-- TableRowBrush is transparent unless a theme gives rows a face of their own. -->
        <Setter Property="Background" Value="{DynamicResource TableRowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <!-- GridRowAltBrush, not RowAltBrush: identical on every ordinary theme (the token
                 mirrors it), but 98SE states its own solid stripe so the Events/Processes/
                 Registry tables read white-and-gray striped. -->
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource GridRowAltBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- GridSelectedTextBrush mirrors PrimaryBrush - exactly the accent this trigger
                 always set, so nothing changes on the ordinary themes. 98SE states WHITE: its
                 selected row is a solid navy block and PrimaryBrush IS that navy, which is what
                 made selected text unreadable in the Registry/Events/Processes tables. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GridSelectedTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sortable column header: TableHeaderBrush behind, MutedTextBrush type at 11, and the
         accent stripe underneath as a 1px HeaderLineBrush bottom border - the same treatment
         FilePane.xaml's own details-view header already carries, so a DataGrid header and the
         file-listing header read as the same furniture. Resize grippers are wired to the exact
         PART_ names WPF expects; a template that drops them silently kills column resizing. -->
    <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="hdrBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <TextBlock x:Name="sortGlyph" Grid.Column="1"
                                           Text="&#x25B2;" FontSize="8"
                                           VerticalAlignment="Center" Margin="6,1,0,0"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Width="8" Margin="-4,0,0,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Ascending}">
                            <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortGlyph" Property="Text" Value="&#x25B2;"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Descending}">
                            <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortGlyph" Property="Text" Value="&#x25BC;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════════════════════
         Kit styles from the other apps that KillerShell's own views never needed: the F1 map
         toggle, the annotation bar, the implicit Slider and RadioButton, toolbar and card close
         buttons, the sidebar rail host, resize grip and fades, tree names, the picker's combo
         box, and the text input context menu.
         ════════════════════════════════════════════════════════════════════════════════════ -->

    <!-- Segmented toggle for the F1 overlay's LIST / KEYBOARD switch and its layer tabs
         (Shell/ShortcutsOverlay.cs): card-border outline at rest, accent outline and text when
         hovered or when Tag="on". The same rule as the rail toggles, so "this one is active" reads
         identically everywhere. -->
    <Style x:Key="KsToggle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Canonical floating annotation/format bar controls. The host uses BgFlyout,
         PaneBorderBrush, Padding=4, CornerRadius=0,0,4,4, and a wrapping content panel. -->
    <Style x:Key="AnnotationBarButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="14"/>
        <!-- Its own template, NOT ChromeButton's. ChromeButton draws a raised beveled face at rest,
             which is right for a caption button and wrong for a toolbar - it makes every ribbon
             button look permanently raised. Here the button is FLAT at rest and only takes a bevel
             while pressed, and that bevel is the SUNKEN one (dark top/left, light bottom/right) so
             it reads as pushed in. Zero thickness at rest, so nothing draws on any theme. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"/>
                        <Border x:Name="bTopLeft" IsHitTestVisible="False" BorderThickness="0"/>
                        <Border x:Name="bBotRight" IsHitTestVisible="False" BorderThickness="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            <Setter TargetName="bTopLeft" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bTopLeft" Property="BorderThickness" Value="{DynamicResource BevelLightThickness}"/>
                            <Setter TargetName="bBotRight" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                            <Setter TargetName="bBotRight" Property="BorderThickness" Value="{DynamicResource BevelDarkThickness}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider. IMPLICIT, so every Slider in a host app picks it up. Without a style here a Slider
         falls through to WPF's default template and paints system colors on a themed card - the
         same fall-through the radio buttons had. Thin sunken groove, tall raised thumb standing
         proud of it: the Win98 trackbar shape, and a plain themed slider elsewhere. -->
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Grid Height="4" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SliderTrack}"
                                    CornerRadius="{DynamicResource SmallCornerRadius}"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        </Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="11" Height="21" Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource SmallCornerRadius}"/>
                                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AnnotationBarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="5,6"/>
        <Setter Property="Fill" Value="{DynamicResource PaneBorderBrush}"/>
    </Style>

    <!-- Themed radio: round ring, accent dot. The checkbox's sibling, with three deliberate
         differences.

         NO Consolas. CheckBox forces a mono label because its labels are short switch names; a
         radio labels a CHOICE, which is usually a phrase, and mono prose reads badly.

         The bullet is TOP-aligned, not centered. A radio option often carries a description under
         its name, and a vertically centered bullet against two lines of text floats between them
         pointing at nothing.

         Content color is left alone. CheckBox mutes its label until checked, which suits a
         switch; an unselected choice still has to be readable enough to choose.

         Added 2026-08-06 - KillerNotes' speech-model chooser was the family's first plain radio,
         and until then a RadioButton fell through to WPF's default template and painted system
         colors on a themed card. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="ring" Width="15" Height="15" CornerRadius="8"
                                VerticalAlignment="Top" Margin="0,2,0,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <Border x:Name="dot" Width="7" Height="7" CornerRadius="4"
                                    Background="{DynamicResource PrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Top"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar button. The glyph sits DIRECTLY on the chrome - no box at rest. Hover FILLS the
         background and nothing else: no colored border, no glyph recolor. KillerPDF has always
         worked this way and it is the family standard (2026-07-30). Deliberately NO fixed
         Width/Height: a toolbar with text-beside / text-under display modes has to grow, so this
         sizes to content and the app varies only Padding per mode. An ACTIVE toolbar button is
         marked by the caller setting Background, not by a border. -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Effect>
                                <!-- IconShadowOpacity is 0 on Light, so the glyph keeps ClearType
                                     there and only the dark themes get the depth. -->
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="270"
                                                  Opacity="{DynamicResource IconShadowOpacity}"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card / overlay close X. Only the GLYPH reddens on hover - never a filled red block, which
         is the Windows caption treatment and wrong on a card floating over the app. Same rule
         ChromeCloseButton follows for the caption X. Content is MDL2 E711, not a literal cross. -->
    <Style x:Key="DangerCloseButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                            <Setter TargetName="Cp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1"
                                                      Direction="270" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The sidebar rail is always 24 logical pixels. Its 20px buttons sit in an asymmetric
         2,0,0,0 host margin: that is a one-pixel optical shift toward the content pane and fixes
         the family-wide left-heavy glyph appearance without widening the rail. -->
    <Style x:Key="RailButtonHost" TargetType="StackPanel">
        <Setter Property="Width" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!-- Sidebar width handle. Keep it INSIDE the sidebar content column, immediately before the
         permanent rail. A GridSplitter or a separate grid column changes the rail width/gap. -->
    <Style x:Key="SidebarResizeGrip" TargetType="Thumb">
        <Setter Property="Width" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Panel.ZIndex" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Rectangle x:Name="line" Width="1" HorizontalAlignment="Right"
                                   Fill="{DynamicResource PaneBorderBrush}" Opacity="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="line" Property="Opacity" Value="1"/>
                            <Setter TargetName="line" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chrome-and-grain edge fades for scrollable sidebars. Put these over the list, inset the
         right edge by the scrollbar width, and let Shell/SidebarChrome.cs drive Opacity. -->
    <Style x:Key="SidebarFadeBase" TargetType="Border">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Panel.ZIndex" Value="40"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
    </Style>

    <Style x:Key="SidebarFadeTop" TargetType="Border" BasedOn="{StaticResource SidebarFadeBase}">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="OpacityMask">
            <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarFadeBottom" TargetType="Border" BasedOn="{StaticResource SidebarFadeBase}">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="OpacityMask">
            <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
    </Style>

    <!-- Node text. SelectionBg/SelectionFg pair on selection, same as the picker rows. -->
    <Style x:Key="TreeName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- File picker type filter. Keep these resources in the shared dictionary so a copied
         FileDialog never depends on an app window's private ComboBox styles. -->
    <Style x:Key="DarkComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SmallCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="7,0,0,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="5,0,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}"
                                         FontSize="11" VerticalAlignment="Center"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Hidden"
                                         Focusable="True" SelectionBrush="{DynamicResource RowSelectedBrush}"
                                         SelectionTextBrush="{DynamicResource PrimaryBrush}"
                                         CaretBrush="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                              Style="{StaticResource DarkComboToggle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade" Placement="Bottom">
                            <Border Background="{DynamicResource PaneBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource SmallCornerRadius}" Padding="2" Margin="0,2,6,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="220">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ContextMenu x:Key="TextInputContextMenu" x:Shared="False">
        <MenuItem Command="ApplicationCommands.Cut"   Header="{DynamicResource Str_Ctx_Cut}"/>
        <MenuItem Command="ApplicationCommands.Copy"  Header="{DynamicResource Str_Ctx_Copy}"/>
        <MenuItem Command="ApplicationCommands.Paste" Header="{DynamicResource Str_Ctx_Paste}"/>
        <Separator/>
        <MenuItem Command="ApplicationCommands.SelectAll" Header="{DynamicResource Str_Ctx_SelectAll}"/>
    </ContextMenu>

</ResourceDictionary>
