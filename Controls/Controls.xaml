                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/><Setter TargetName="DayGrain" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
