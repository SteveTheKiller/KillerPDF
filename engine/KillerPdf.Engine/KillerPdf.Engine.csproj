<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>KillerPdf.Engine</RootNamespace>
    <AssemblyName>KillerPdf.Engine</AssemblyName>
    <Version>1.9.6</Version>
    <PackageId>KillerPdf.Engine</PackageId>
    <Title>The KillerPDF.Engine</Title>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <Description>An independent .NET PDF 2.0 engine for reading, text extraction, rendering, search, editing, redaction, forms including XFA, signing and timestamp validation, certificate encryption, OCR, export to Office, HTML, Markdown and JSON, optimization, preflight, imposition, measurement, comparison, ICC color management and printer proofing, and native EPUB and DjVu reading with conversion to PDF.</Description>
    <PackageTags>pdf;pdf-2.0;pdf-a;pdf-ua;pdf-x;validation;preflight;authoring;editing;rendering;text-extraction;ocr;redaction;forms;acroform;xfa;signing;digital-signature;timestamp;encryption;export;docx;accessibility;imposition;color-management;icc;epub;djvu;document-processing;csharp</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://killerpdf.net/engine.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SteveTheKiller/KillerPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/SteveTheKiller/KillerPDF/blob/main/engine/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="VerifyAppEngineVersion" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../KillerPDF.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="KillerAppVersion" />
    </XmlPeek>
    <Error Condition="'$(Version)' != '$(KillerAppVersion)'" Text="Engine version $(Version) must match app version $(KillerAppVersion). Update both before building or packaging." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Update="Resources\Fonts\LIBERATION-LICENSE.txt" Pack="true"
          PackagePath="\" />
    <None Update="Filters\Jbig2\LICENSE.txt" Pack="true"
          PackagePath="third_party\jbig2\LICENSE.txt" />
    <None Update="Filters\Jbig2\NOTICE.txt" Pack="true"
          PackagePath="third_party\jbig2\NOTICE.txt" />
    <EmbeddedResource Include="Resources\Fonts\Liberation*.ttf"
                      LogicalName="KillerPdf.Engine.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\ColorProfiles\CGATS001Compat-v2-micro.icc"
                      LogicalName="KillerPdf.Engine.ColorProfiles.CGATS001Compat-v2-micro.icc" />
    <EmbeddedResource Include="Resources\ColorProfiles\CGATS001Compat-v2-micro.rgb-inverse.bin"
                      LogicalName="KillerPdf.Engine.ColorProfiles.CGATS001Compat-v2-micro.rgb-inverse" />
    <None Update="Resources\ColorProfiles\CGATS001Compat-v2-micro.icc" Pack="true"
          PackagePath="color_profiles\" />
    <None Update="Resources\ColorProfiles\COMPACT-ICC-CC0-LICENSE.txt" Pack="true"
          PackagePath="color_profiles\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\OpenJPEG\win-x64\openjp2.dll" Link="openjp2.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/openjp2.dll">
      <CopyToOutputDirectory Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\third_party\OpenJPEG\linux-x64\libopenjp2.so" Link="libopenjp2.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/libopenjp2.so">
      <CopyToOutputDirectory Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\third_party\OpenJPEG\osx-arm64\libopenjp2.dylib" Link="osx-arm64\libopenjp2.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/libopenjp2.dylib" />
    <None Include="..\..\third_party\OpenJPEG\osx-x64\libopenjp2.dylib" Link="osx-x64\libopenjp2.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/libopenjp2.dylib" />
    <None Include="..\..\third_party\OpenJPEG\LICENSE.txt" Link="OpenJPEG-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="third_party/openjpeg/" />
  </ItemGroup>

</Project>
