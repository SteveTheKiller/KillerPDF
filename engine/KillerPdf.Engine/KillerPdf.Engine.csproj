<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>KillerPdf.Engine</RootNamespace>
    <AssemblyName>KillerPdf.Engine</AssemblyName>
    <Version>1.9.2</Version>
    <PackageId>KillerPdf.Engine</PackageId>
    <Title>The KillerPDF.Engine</Title>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <Description>An independent .NET PDF 2.0 engine for reading, text extraction, rendering, search, editing, redaction, forms including XFA, signing and timestamp validation, certificate encryption, OCR, export to Office, HTML, Markdown and JSON, optimization, preflight, imposition, measurement, and comparison.</Description>
    <PackageTags>pdf;pdf-2.0;pdf-a;pdf-ua;pdf-x;validation;preflight;authoring;editing;rendering;text-extraction;ocr;redaction;forms;acroform;xfa;signing;digital-signature;timestamp;encryption;export;docx;accessibility;imposition;document-processing;csharp</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://killerpdf.net/engine.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SteveTheKiller/KillerPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/SteveTheKiller/KillerPDF/blob/main/engine/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Packs the vendored JPEG 2000 codec (IncludeVendoredCodec below). Kept in this one
         PropertyGroup: release.ps1 reads Project.PropertyGroup.Version under StrictMode, which
         throws when a second PropertyGroup has no Version. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeVendoredCodec</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="VerifyAppEngineVersion" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../KillerPDF.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="KillerAppVersion" />
    </XmlPeek>
    <Error Condition="'$(Version)' != '$(KillerAppVersion)'" Text="Engine version $(Version) must match app version $(KillerAppVersion). Update both before building or packaging." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored JPEG 2000 codec. See third_party/CoreJ2K/VENDORING.md. -->
    <ProjectReference Include="..\..\third_party\CoreJ2K\CoreJ2K\CoreJ2K.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeVendoredCodec" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'CoreJ2K' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Update="Resources\Fonts\LIBERATION-LICENSE.txt" Pack="true"
          PackagePath="\" />
    <None Update="Filters\Jbig2\LICENSE.txt" Pack="true"
          PackagePath="third_party\jbig2\LICENSE.txt" />
    <None Update="Filters\Jbig2\NOTICE.txt" Pack="true"
          PackagePath="third_party\jbig2\NOTICE.txt" />
    <EmbeddedResource Include="Resources\Fonts\Liberation*.ttf"
                      LogicalName="KillerPdf.Engine.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
