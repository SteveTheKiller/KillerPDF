<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName Condition="'$(KillerUiSmokeAssemblyName)' != ''">$(KillerUiSmokeAssemblyName)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\engine\KillerPdf.Engine\KillerPdf.Engine.csproj" />
    <!-- Test tooling only. The application excludes tests/** from its item globs. -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <Compile Include="..\..\PreviewHandler\ShellInterfaces.cs" Link="PreviewShellInterfaces.cs" />
  </ItemGroup>
</Project>
