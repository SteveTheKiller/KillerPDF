<Window x:Class="KillerLauncher.LauncherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerPDF" MinWidth="380" MaxWidth="620" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#e0e0e0"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="7"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="Wordmark">./Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>
        <SolidColorBrush x:Key="Green" Color="#1ea54c"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="22,2"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#1ea54c"/>
            <Setter Property="Foreground" Value="#1ea54c"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="#1ea54c"/>
                        <Setter Property="Foreground" Value="#0a0a0a"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="#0d2a18"/>
                        <Setter Property="Foreground" Value="#1ea54c"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="#1c1c1c" BorderBrush="#3f3f3f" BorderThickness="1" CornerRadius="7"
            MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.72" RenderingBias="Quality"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Border x:Name="GrainLayer" CornerRadius="7" IsHitTestVisible="False" Opacity="0.40"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,10,16,10">
                    <Image x:Name="TitleIcon" Width="27" Height="27" Margin="0,0,7,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock VerticalAlignment="Center"><Run Text="Killer" FontFamily="{StaticResource Wordmark}" FontSize="15"/><Run Text="PDF" FontFamily="{StaticResource Wordmark}" FontSize="19.5" FontWeight="Bold" Foreground="{StaticResource Green}"/></TextBlock>
                </StackPanel>
                <TextBlock x:Name="MessageText" Margin="20,6,20,8" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
                <Button x:Name="OkButton" Content="{local:Loc OK}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                        HorizontalAlignment="Right" Margin="16,8,16,16" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
