<Window x:Class="KillerLauncher.InstallerWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerPDF Setup" Width="650" Height="350"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#e0e0e0"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="7"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="Wordmark">./Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>
        <SolidColorBrush x:Key="Green" Color="#1ea54c"/>
        <Style x:Key="FooterLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#6a6a6a"/><Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#1ea54c"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="68"/>
            <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Padding" Value="12,2"/>
            <Setter Property="Foreground" Value="#e0e0e0"/><Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="BorderBrush" Value="#505050"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#424242"/><Setter TargetName="Face" Property="BorderBrush" Value="#707070"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#242424"/><Setter TargetName="Face" Property="BorderBrush" Value="#1ea54c"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#1ea54c"/>
            <Setter Property="Foreground" Value="#1ea54c"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="#1ea54c"/>
                        <Setter Property="Foreground" Value="#0a0a0a"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="#0d2a18"/>
                        <Setter Property="Foreground" Value="#1ea54c"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e0e0e0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Ring" Width="12" Height="12" CornerRadius="6" BorderBrush="#777777" BorderThickness="1.2" Background="#292929" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#1ea54c" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="BorderBrush" Value="#1ea54c"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#34c866"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="13" Height="13" CornerRadius="2" BorderBrush="#777777" BorderThickness="1" Background="#292929" VerticalAlignment="Center">
                        <Path x:Name="Check" Data="M 2,6 L 5,9 L 11,2" Stroke="#101010" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#1ea54c"/><Setter TargetName="Box" Property="BorderBrush" Value="#1ea54c"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#34c866"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="#e0e0e0"/><Setter Property="Background" Value="#292929"/>
            <Setter Property="BorderBrush" Value="#505050"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#1ea54c"/>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Margin="8" Background="#1c1c1c" BorderBrush="#3f3f3f" BorderThickness="1"
            CornerRadius="7" ClipToBounds="False" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.72" RenderingBias="Quality"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="FrameGrain" Grid.ColumnSpan="2" CornerRadius="7" IsHitTestVisible="False" Opacity="0.40"/>

            <Border Grid.Column="0" Background="#1c1c1c" CornerRadius="7,0,0,7">
                <Grid>
                    <Border x:Name="SidebarGrain" CornerRadius="7,0,0,7" IsHitTestVisible="False" Opacity="0.40"/>
                    <Grid Margin="22,20,18,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Image Source="Resources/kp-icon.png" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></Image.Effect>
                    </Image>
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock><TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.65"/></TextBlock.Effect><Run Text="Killer" FontFamily="{StaticResource Wordmark}" FontSize="26"/><Run Text="PDF" FontFamily="{StaticResource Wordmark}" FontSize="33" FontWeight="Bold" Foreground="{StaticResource Green}"/></TextBlock>
                        <TextBlock Text="SETUP  •  1.8.8" FontFamily="Consolas" FontSize="9.5" Foreground="#a0a0a0" Margin="1,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="1,24,5,0" TextWrapping="Wrap" Foreground="#d0d0d0" LineHeight="17"
                               Text="A free and modern PDF editor, built from scratch for privacy and speed."/>
                    <TextBlock Grid.Row="3" FontFamily="Consolas" FontSize="10" Foreground="#a0a0a0">
                        <Run Text="&#x00A9; 2026 "/><Hyperlink NavigateUri="https://github.com/Rafie-kun/KillerPDF" Click="Website_Click" Style="{StaticResource FooterLink}"><Run Text="Rafie-kun"/></Hyperlink>
                    </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="8,8,8,8">
                <Border Background="#171717" CornerRadius="6">
                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.72" RenderingBias="Quality"/></Border.Effect>
                </Border>
                <Border x:Name="ContentCard" Background="#3a3a3a" BorderBrush="#2e2e2e" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Border x:Name="GrainLayer" CornerRadius="6" IsHitTestVisible="False" Opacity="0.52"/>
                        <Button x:Name="CloseButton" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                Background="Transparent" BorderThickness="0" Foreground="#b8b8b8" Cursor="Hand" Click="Cancel_Click" Panel.ZIndex="3">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><Path x:Name="CloseGlyph" Data="M 5,5 L 13,13 M 13,5 L 5,13" Stroke="#b8b8b8" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseGlyph" Property="Stroke" Value="#e35d6a"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Grid Margin="24,20,24,14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,28,0"/>
                            <TextBlock x:Name="Copy" Grid.Row="1" Foreground="#a8a8a8" Margin="0,5,25,12"
                                       TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="19"/>
                            <StackPanel x:Name="Options" Grid.Row="2">
                                <RadioButton x:Name="CurrentUser" Content="Install for my account" IsChecked="True" Checked="Scope_Checked"/>
                                <RadioButton x:Name="AllUsers" Content="Install for everyone on this computer" Checked="Scope_Checked"/>
                                <Separator Margin="0,2,0,5" Background="#505050"/>
                                <TextBlock Text="Install folder" FontSize="11" Foreground="#bdbdbd" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallFolder" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource WizardButton}" Height="27" MinWidth="72" Click="Browse_Click"/>
                                </Grid>
                                <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True"/>
                            </StackPanel>
                            <Grid Grid.Row="3" Margin="0,6,0,9" Height="14">
                                <TextBlock x:Name="RuntimeStatus" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Right"/>
                                <Grid x:Name="InstallProgress" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="INSTALLING" FontFamily="Consolas" FontSize="9" Foreground="#a8a8a8"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Grid.Column="1" Height="3" Background="#242424" CornerRadius="1.5"
                                            VerticalAlignment="Center" ClipToBounds="True">
                                        <Canvas>
                                            <Rectangle Width="86" Height="3" RadiusX="1.5" RadiusY="1.5">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#001ea54c" Offset="0"/>
                                                        <GradientStop Color="#1ea54c" Offset="0.5"/>
                                                        <GradientStop Color="#001ea54c" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                                <Rectangle.RenderTransform><TranslateTransform X="-86"/></Rectangle.RenderTransform>
                                                <Rectangle.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                 From="-86" To="360" Duration="0:0:1.35"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Rectangle.Triggers>
                                            </Rectangle>
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BackButton" Content="Back" Style="{StaticResource WizardButton}" Click="Back_Click"/>
                                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource WizardButton}" Click="Cancel_Click"/>
                                <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="NoticeOverlay" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
                  Background="#B8000000">
                <Border Width="390" MinHeight="150" Padding="22,18,22,16" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Background="#303030" BorderBrush="#515151"
                        BorderThickness="1" CornerRadius="6">
                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.85"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="NoticeRing" Width="28" Height="28" CornerRadius="14" BorderThickness="2"
                                    Background="#242424" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="NoticeGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="NoticeHeading" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#f0f0f0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="NoticeMessage" Grid.Row="1" Margin="42,13,0,20" Foreground="#c8c8c8"
                                   LineHeight="18" TextWrapping="Wrap"/>
                        <Button x:Name="NoticeOk" Grid.Row="2" Content="OK" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" IsDefault="True" Click="NoticeOk_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
