<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#2E0022" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#2E0022" po:Freeze="True"/>
    <LinearGradientBrush x:Key="SelectionBg"     po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF48CE" Offset="0"/><GradientStop Color="#F31FB1" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionFg"     Color="#1E1F22" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#88FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#FF2BBD" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#2E0022" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#FF2BBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#2E0022" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF2BBD" po:Freeze="True"/>

</ResourceDictionary>
