<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#2E2B00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#2E2B00" po:Freeze="True"/>
    <LinearGradientBrush x:Key="SelectionBg"     po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF58A" Offset="0"/><GradientStop Color="#E4C000" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionFg"     Color="#1E1F22" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#88FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#FFEB00" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#2E2B00" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#FFEB00" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#2E2B00" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFEB00" po:Freeze="True"/>

</ResourceDictionary>
