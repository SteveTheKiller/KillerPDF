<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Trash Polka family - MOSS accent overlay (Green). -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#303A1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#303A1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#887A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#667A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentLogo"          Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"     Color="#7A9A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"         Color="#7A9A3A" po:Freeze="True"/>
</ResourceDictionary>
