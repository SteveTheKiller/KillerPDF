<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Trash Polka family - ROSE accent overlay (Magenta). -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#502636" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#502636" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#88E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#66E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentLogo"          Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"     Color="#E4588E" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"         Color="#E4588E" po:Freeze="True"/>
</ResourceDictionary>
