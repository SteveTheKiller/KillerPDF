<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Trash Polka family - YELLOW accent overlay. A real yellow, never ochre or gold (Steve 2026-11-23): a dark yellow
         reads brown, so a selected row is the bright yellow itself with dark text, as on Light and 98SE. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="GridSelectedTextBrush"     Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="GridSelectedTypeTextBrush" Color="#111111" po:Freeze="True"/>
    <!-- A checked card tile is filled with RowSelectedBrush, so its glyph and caption go dark too. -->
    <SolidColorBrush x:Key="TileCheckedTextBrush" Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#C9B400" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#88EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#66EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#111111"/>
    <SolidColorBrush x:Key="AccentLogo"          Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"     Color="#EED500" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"         Color="#EED500" po:Freeze="True"/>
</ResourceDictionary>
