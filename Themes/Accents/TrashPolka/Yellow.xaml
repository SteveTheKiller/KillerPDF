<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Trash Polka family - OCHRE accent overlay (Yellow). -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#4D3C14" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#4D3C14" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#88D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#66D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentLogo"          Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"     Color="#D9A21B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"         Color="#D9A21B" po:Freeze="True"/>
</ResourceDictionary>
