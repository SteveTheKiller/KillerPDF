<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Trash Polka family - TEAL accent overlay (Teal). -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#153A39" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#111111" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#153A39" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#881E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#661E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentLogo"          Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"     Color="#1E9A96" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"         Color="#1E9A96" po:Freeze="True"/>
</ResourceDictionary>
