<!-- KillerPDF's own Trash Polka values: keys the kit palette does not define. AppTheme's
     AppDerivedTokens (Services/AppTheme.cs) adds them; kit keys always keep the kit's value.
     The canvas stays ink so the window's sleeve reads behind the pages. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BgRecentPanel"  Color="#2E2926" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#00000000"/>
        <GradientStop Offset="0.55" Color="#1f000000"/>
        <GradientStop Offset="1.0" Color="#82000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DropBorder"     Color="#5A544E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg" Color="#463F3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"      Color="#ff4444" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"   Color="#9A938A" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"       Color="#5A544E" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"      Color="#CC000000" po:Freeze="True"/>
    <sys:Double x:Key="HeaderShadowOpacity">0.5</sys:Double>
    <SolidColorBrush x:Key="BgCanvas"       Color="#111111" po:Freeze="True"/>
</ResourceDictionary>
